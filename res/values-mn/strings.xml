    <string name="string_0x7f130002">Муж улс</string>
    <string name="string_0x7f130003">Хот</string>
    <string name="string_0x7f130004">Хаяг</string>
    <string name="string_0x7f130006">Байр/тоот (заавал биш)</string>
    <string name="string_0x7f130008">Зарын бүртгэлээсээ картыг автоматаар бөглөх үү?</string>
    <string name="string_0x7f130012">Автоматаар бөглөх</string>
    <string name="string_0x7f130024">Таны мэдээллийг хэрхэн ашиглаж, удирддаг тухай</string>
    <string name="string_0x7f130025">Одоо биш</string>
    <string name="string_0x7f13002c">Вэб хөтчийг хаах</string>
    <string name="string_0x7f13002e">%1$s таны төхөөрөмжийн камер болон микрофоныг ашиглахыг хүсэж байна.</string>
    <string name="string_0x7f13002f">%1$s таны төхөөрөмжийн камерыг ашиглахыг хүсэж байна.</string>
    <string name="string_0x7f130030">%1$s таны төхөөрөмжийн байршлыг ашиглах хүсэлтэй байна.</string>
    <string name="string_0x7f130032">Файл сонгогчийг хэрэглэхийн тулд бүх медиаг зөвшөөрнө үү</string>
    <string name="string_0x7f130033">Зөвшөөрөх</string>
    <string name="string_0x7f130034">Хориглох</string>
    <string name="string_0x7f130035">Хөтчийг багасгах</string>
    <string name="string_0x7f130036">Буцах</string>
    <string name="string_0x7f130037">Цааш үргэлжлүүлэх</string>
    <string name="string_0x7f130038">Энэ сайтын хамгаалалтын сертификат асуудалтай байна</string>
    <string name="string_0x7f130039">Буцах</string>
    <string name="string_0x7f13003a">Хамгаалалтын алдаа</string>
    <string name="string_0x7f13003b">Толгой хэсэг</string>
    <string name="string_0x7f130076">Хадгалсан мэдээллээр автоматаар бөглөх үү?</string>
    <string name="string_0x7f13008d">Ямар нэгэн алдаа гарлаа.</string>
    <string name="string_0x7f13008e">Үл хэрэгсэх</string>
    <string name="string_0x7f13008f">Имэйл</string>
    <string name="string_0x7f130091">Таны үзэж буй вэб сайт гадны апп нээхийг оролдож байна. Та үргэлжлүүлэхийг хүсч байна уу?</string>
    <string name="string_0x7f130092">Буцах</string>
    <string name="string_0x7f130093">Үргэлжлүүлэх</string>
    <string name="string_0x7f130094">Та манай аппаас гарч байна</string>
    <string name="string_0x7f130095">Энэ нь бидний залруулахаар ажиллаж буй техникийн алдаанаас үүдсэн байж болно. Хуудсыг дахин ачаална уу.</string>
    <string name="string_0x7f130096">Сэргээх</string>
    <string name="string_0x7f130097">Хуудас одоогоор боломжгүй байна</string>
    <string name="string_0x7f130098">Овог</string>
    <string name="string_0x7f130099">Хуудсыг ачаалах боломжгүй байна</string>
    <string name="string_0x7f13009a">Дараах хэрэглүүрээр нээх …</string>
    <string name="string_0x7f13009b">\"%1$s\" дээр нээх</string>
    <string name="string_0x7f13009c">Бусад сонголт</string>
    <string name="string_0x7f1300aa">Нэр</string>
    <string name="string_0x7f1300af">Та одоо бүтэн дэлгэцээр үзэж байна. Гарахын тулд зүүн тийш шудрах эсвэл буцах товчийг товшино уу.</string>
    <string name="string_0x7f1300cb">Бид яг одоо %1$s-д %2$s-г тохируулахад асуудалтай байна. Та дахин оролдож үзэх эсвэл одоогоор %2$s-г Англи (АНУ) хэл дээр ашиглана уу.</string>
    <string name="string_0x7f1300cc">%1$s хэлийг тохируулах хүртэл түр хүлээнэ үү...</string>
    <string name="string_0x7f1300cd">Дахин оролдох</string>
    <string name="string_0x7f1300ce">Англи (АНУ) хэлээр үргэлжлүүлэх</string>
    <string name="string_0x7f1300cf">Холбоосны түүх. Өмнө нь зочилсон вебсайтуудын холбоосын жагсаалтыг харахын тулд хоёр товшино уу.</string>
    <string name="string_0x7f1300d0">Цуцлах</string>
    <string name="string_0x7f1300da">Хаах</string>
    <string name="string_0x7f1300dd">Карт нэмэхийн тулд товшино уу</string>
    <string name="string_0x7f13010b">Зип код</string>
    <string name="string_0x7f130119">Төлбөрийн нэхэмжлэх илгээх хаяг хүргэх хаягтай ижил болохыг бататгана уу</string>
    <string name="string_0x7f13011a">[картын брэнд эсвэл олгосон байгууллага] картын зураг</string>
    <string name="string_0x7f13011b">Автоматаар бөглөх мэдээлэл болон удирдлагыг дэлгэх</string>
    <string name="string_0x7f130126">Дэлгэрэнгүй мэдээлэл авна уу</string>
