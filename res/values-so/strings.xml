    <string name="string_0x7f13002f">%1$s waxa uu doonayaa in uu isticmaalo kaamirada aaladdaada.</string>
    <string name="string_0x7f130030">%1$s ayaa rabo inuu isticmaalo goobta aaladaada.</string>
