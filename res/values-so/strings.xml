    <string name="string_0x7f130099">Bogga lama soo muujin karo</string>
    <string name="string_0x7f13009a">Ku fur ...</string>
    <string name="string_0x7f13009b">Ku fur %1$s</string>
    <string name="string_0x7f13009c">Ikhtiyaaro badan</string>
    <string name="string_0x7f1300aa">Magaca Koowaad</string>
    <string name="string_0x7f1300af">Waxaad hadda ku daawanaysaa shaashad dhammeystiran. Dhinaca bidix u dhaqaaji ama taabo badhanka dib u noqo si aad uga baxdo.</string>
    <string name="string_0x7f1300cb">Waxaan dhibaato ku qabnaa dajinta %2$s ee %1$s hadeer. Waad isku dayi kartaa markale, ama ku isticmaali kartaa %2$s af Ingiriis (US) hadda.</string>
    <string name="string_0x7f1300cc">Waxyar inta aan diyaarineyno %1$s…</string>
    <string name="string_0x7f1300cd">Markale isku day</string>
    <string name="string_0x7f1300ce">Ku sii wad Ingiriiska (US)</string>
