<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="@android:color/black" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/camera_container_view" android:layout_width="match_parent" android:layout_height="match_parent">
        <view android:id="@id/camera_view" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true" class="android.view.SurfaceView" />
        <view android:id="@id/boomerang_flash_overlay" android:background="@android:color/white" android:visibility="invisible" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0.0" class="android.view.View" />
        <com.instagram.honolulu.views.customviews.FocusView android:id="@id/focus_view" android:layout_width="match_parent" android:layout_height="match_parent" />
        <view android:layout_gravity="left|top" android:id="@id/concurrent_camera_bounds" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" class="android.view.View" />
        <com.instagram.honolulu.views.customviews.CountdownTimerView android:layout_gravity="center" android:id="@id/countdown_timer" android:visibility="gone" android:layout_width="200.0dp" android:layout_height="200.0dp" />
    </FrameLayout>
    <FrameLayout android:id="@id/cover_frame" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@id/cover_frame_image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
    </FrameLayout>
    <include android:id="@id/controls_container" layout="@layout/honolulu_camera_ui_overlay" />
    <FrameLayout android:id="@id/camera_permissions_cover" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@id/camera_settings_container" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
