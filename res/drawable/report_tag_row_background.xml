<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/account_discovery_bottom_gap" />
            <gradient android:startColor="@color/white_25_transparent" android:endColor="@color/white_2_transparent" android:angle="0.0" android:type="linear" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape>
            <corners android:radius="@dimen/account_discovery_bottom_gap" />
            <gradient android:startColor="@color/white_8_transparent" android:endColor="@color/transparent_white" android:angle="0.0" android:type="linear" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/account_discovery_bottom_gap" />
            <solid android:color="#63505050" />
        </shape>
    </item>
</selector>
