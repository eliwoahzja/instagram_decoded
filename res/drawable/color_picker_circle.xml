<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/shadow">
        <shape android:shape="oval">
            <gradient android:startColor="@color/ask_shop_question_card_scrim" android:endColor="@color/bds_transparent" android:angle="0.0" android:type="radial" android:gradientRadius="0.0" />
        </shape>
    </item>
    <item android:id="@id/ring">
        <shape android:shape="oval">
            <size android:height="24.0dp" android:width="24.0dp" />
            <solid android:color="@color/bds_white" />
        </shape>
    </item>
    <item android:id="@id/fill">
        <shape android:shape="oval">
            <solid android:color="@color/bds_white" />
        </shape>
    </item>
</layer-list>
