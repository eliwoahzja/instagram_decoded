<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <solid android:color="@color/bds_grey_3" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <solid android:color="@color/bds_grey_3" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient android:startColor="@color/bds_orange_5" android:endColor="@color/bds_green_5" android:angle="0.0" android:centerColor="@color/basel_speed_bar_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
