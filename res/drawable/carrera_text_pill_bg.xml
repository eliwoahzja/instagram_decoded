<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?igds_color_prism_chip_background_pressed" />
            <stroke android:width="@dimen/afi_segmented_pill_border_width" android:color="?igds_color_prism_chip_background_stroke" />
            <corners android:radius="@dimen/action_bar_item_spacing_right" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?igds_color_prism_chip_background" />
            <stroke android:width="@dimen/afi_segmented_pill_border_width" android:color="?igds_color_prism_chip_background_stroke" />
            <corners android:radius="@dimen/action_bar_item_spacing_right" />
        </shape>
    </item>
</selector>
