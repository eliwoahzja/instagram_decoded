<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bds_white_20_transparent" />
            <stroke android:width="@dimen/account_preview_media_end_card_stroke_width" android:color="@color/bds_white_40_transparent" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bds_transparent" />
            <stroke android:width="@dimen/account_preview_media_end_card_stroke_width" android:color="@color/bds_white_40_transparent" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
        </shape>
    </item>
</selector>
