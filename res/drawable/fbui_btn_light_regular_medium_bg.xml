<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/fbui_bluegrey_20" />
            <stroke android:width="1.0dp" android:color="@color/fbui_bluegrey_20" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_floating_window_z" android:top="@dimen/account_discovery_bottom_gap" android:right="@dimen/abc_floating_window_z" android:bottom="@dimen/account_discovery_bottom_gap" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/abc_decor_view_status_guard_light" />
            <stroke android:width="1.0dp" android:color="@color/fbui_bluegrey_10" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_floating_window_z" android:top="@dimen/account_discovery_bottom_gap" android:right="@dimen/abc_floating_window_z" android:bottom="@dimen/account_discovery_bottom_gap" />
        </shape>
    </item>
</selector>
