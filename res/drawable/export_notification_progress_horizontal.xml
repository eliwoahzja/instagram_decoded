<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/igds_prism_gray_03" />
            <corners android:radius="12.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/bds_purple_5" android:endColor="@color/bds_orange_5" android:angle="0.0" android:type="linear" android:centerColor="@color/bds_lavender_5" />
                <corners android:radius="12.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
