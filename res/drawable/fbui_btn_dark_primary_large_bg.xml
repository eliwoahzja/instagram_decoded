<?xml version="1.0" encoding="utf-8"?>
<selector android:variablePadding="false"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true" android:state_pressed="true">
        <shape>
            <solid android:color="#33ffffff" />
            <stroke android:width="1.0dp" android:color="@color/fbui_accent_blue" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_dialog_padding_material" android:top="@dimen/action_bar_item_spacing_right" android:right="@dimen/abc_dialog_padding_material" android:bottom="@dimen/action_bar_item_spacing_right" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <solid android:color="#0dffffff" />
            <stroke android:width="1.0dp" android:color="@color/fbui_accent_blue" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_dialog_padding_material" android:top="@dimen/action_bar_item_spacing_right" android:right="@dimen/abc_dialog_padding_material" android:bottom="@dimen/action_bar_item_spacing_right" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#0dffffff" />
            <stroke android:width="1.0dp" android:color="@color/fbui_btn_dark_primary_stroke_disabled" />
            <corners android:radius="@dimen/abc_action_bar_elevation_material" />
            <padding android:left="@dimen/abc_dialog_padding_material" android:top="@dimen/action_bar_item_spacing_right" android:right="@dimen/abc_dialog_padding_material" android:bottom="@dimen/action_bar_item_spacing_right" />
        </shape>
    </item>
</selector>
