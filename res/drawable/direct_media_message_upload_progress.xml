<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:useLevel="false" android:innerRadius="14.0dp" android:thickness="1.75dp">
            <solid android:color="@color/bds_black" />
            <size android:height="35.0dp" android:width="35.0dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <shape android:shape="ring" android:useLevel="true" android:innerRadius="14.0dp" android:thickness="1.75dp">
            <solid android:color="@color/bds_grey_2" />
            <size android:height="35.0dp" android:width="35.0dp" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="0.0" android:toDegrees="360.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:useLevel="false" android:innerRadius="14.0dp" android:thickness="1.75dp">
                <gradient android:startColor="#00000000" android:endColor="@color/bds_grey_2" android:useLevel="false" android:angle="0.0" android:type="sweep" android:centerX="0.5" android:centerY="0.5" />
                <size android:height="35.0dp" android:width="35.0dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
