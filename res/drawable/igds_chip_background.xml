<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/igds_chip_radius" />
            <stroke android:width="@dimen/afi_segmented_pill_border_width" android:color="?igds_color_border_secondary" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <shape android:shape="rectangle">
            <solid android:color="?igds_color_inbox_filter_chip_selected_background" />
            <corners android:radius="@dimen/igds_chip_radius" />
        </shape>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?igds_color_inbox_filter_chip_pressed_background" />
            <corners android:radius="@dimen/igds_chip_radius" />
        </shape>
    </item>
</selector>
