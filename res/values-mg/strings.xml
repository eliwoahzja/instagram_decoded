    <string name="string_0x7f130036">Miverina</string>
    <string name="string_0x7f130037">Mandroso</string>
    <string name="string_0x7f130038">"Misy olana ny sertifikà fiarovan'ity tranonkala ity"</string>
    <string name="string_0x7f130039">Miverina</string>
    <string name="string_0x7f13003a">"Tsy fetezan'ny fiarovana"</string>
    <string name="string_0x7f13003b">Andohany</string>
    <string name="string_0x7f13008e">Tsy miraharaha</string>
    <string name="string_0x7f130091">Manandrana manokatra app ivelany iray ilay tranonkala jerenao. Te hanohy ve ianao?</string>
    <string name="string_0x7f130092">Miverina</string>
    <string name="string_0x7f130093">Manohy</string>
    <string name="string_0x7f130094">"Miala amin'ny appnay ianao"</string>
    <string name="string_0x7f130095">Mety ho noho ny hadisoana ara-tekinika iray izay ezahinay vahana izany. Andramo fahanana indray ity pejy ity.</string>
    <string name="string_0x7f130096">Manavao</string>
    <string name="string_0x7f130097">"Tsy vonona ilay Pejy amin'izao"</string>
    <string name="string_0x7f130098">Anarana</string>
    <string name="string_0x7f130099">Tsy mety afatratra ilay Pejy</string>
    <string name="string_0x7f13009a">"Sokafina amin'i…"</string>
    <string name="string_0x7f13009b">"Sokafina ao amin'i %1$s"</string>
    <string name="string_0x7f13009c">Safidy bebe kokoa</string>
    <string name="string_0x7f1300aa">"Fanampin'anarana"</string>
    <string name="string_0x7f1300af">Mijery efijery feno ianao izao. Asosay miankavia na kitiho ilay bokotra miverina hivoahana.</string>
    <string name="string_0x7f1300cf">"Tantaran-drohy. Kitiho indroa hahitana lisi-drohy mankany amin'ireo tranonkala notsidihinao teo aloha."</string>
