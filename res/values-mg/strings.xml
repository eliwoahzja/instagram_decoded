    <string name="string_0x7f130008">"Mameno ho azy amin'ny karatra avy amin'ny kaontin-dokanao?"</string>
    <string name="string_0x7f13002c">Hanakatona mpitety tranonkala</string>
    <string name="string_0x7f13002e">"Te hampiasa ny fakantsary sy mikiraon'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="string_0x7f13002f">"Te hampiasa ny fakantsarin'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="string_0x7f130030">Te-hampiasa ny toerana misy ny fitaovan-tseraseranao i %1$s.</string>
    <string name="string_0x7f130031">"Te hampiasa ny mikiraon'ny fitaovan-tseraseranao i %1$s."</string>
    <string name="string_0x7f130032">Mba omeo lalana ny haino vaky jery rehetra hampiasa fisafidianan-drakitra azafady.</string>
    <string name="string_0x7f130033">Manome lalana</string>
    <string name="string_0x7f130034">Manakana</string>
