{
  "schemaVersion": 1,
  "identifier": "video_cutout_focus_label",
  "displayName": "Focus Label",
  "description": "[Instagram Edits] Effect browser - Label for an effect that draws focus-style brackets or dashed outlines around subjects. Character count for labels is 14 characters max.",
  "iglu": {
    "legacyId": 2114,
    "customization": [
      {
        "name": "amount",
        "displayMethod": "number",
        "default": 1.0,
        "min": 1.0,
        "max": 3.0,
        "displayName": "Label type",
        "displayNameDescription": "The type of label to use. 1 = Bracketed, 2 = solid, 3 = Dashed"
      },
      {
        "name": "intensity",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Blur",
        "displayNameDescription": "The amount of blur to apply to outside the focus label. 0 = no blur, 1 = full blur"
      },
      {
        "name": "zoom",
        "default": 1.1,
        "min": 1.0,
        "max": 2.0,
        "displayName": "Zoom",
        "displayNameDescription": "The amount zoom inside the focus label. 1 = no zoom, 2 = full zoom"
      },
      {
        "name": "size",
        "default": 0.1,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Size",
        "displayNameDescription": "The scale of the focus label. 0.0 = no scale, 1 = max scale"
      },
      {
        "name": "speed",
        "default": 0.6,
        "min": 0.0,
        "max": 1.0,
        "displayName": "Stroke width",
        "displayNameDescription": "The width of the stroke around the focus label."
      }
    ],
    "subject": {
      "enabled": true,
      "fullFrameEnabled": false,
