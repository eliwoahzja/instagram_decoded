[Filter TextPath]
#
# Path text animation — continuous looping positional drift along a baked path curve (SlideRight LUT),
# blended over a fixed 2-iteration trail. LOOP family: shader `time` is driven from the host
# `renderFrameTimeSeconds` param, not `time_sec`. LUT is the shared
# TextEffectsSharedAssets/SlideRight "slide_right" PNG. The constant 2-iteration loop unrolls;
# overloaded map() is split into map()/mapSimple(). No behavior header (Static). Metal is generated by
# shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {renderFrameTimeSeconds = 0.0, description = "Continuous media time (seconds), host-driven"},
        {speed = 0.3},
        {loop = 1.0},
        {locationXChannel = 0.0},
        {locationXMin = -1.5},
        {locationXMax = 1.5},
        {locationYChannel = 0.0},
        {locationYMin = 0.0},
        {locationYMax = 0.0},
        {playbackSpeedByWidth = 0.0},
        {phase = 0.5},
        {translationIntensity = 1.0},
    };

    loadTexture('animation, 'texture://TextEffectsSharedAssets/SlideRight);

    filter.passes = {{
        name = 'path,
        inputs = {'default, 'animation},
        uniforms = {
            outputSize = {100.0, 100.0},
            time = 0.0,
            speed = 0.3,
            loop = 1.0,
            locationXChannel = 0.0,
            locationXMin = -1.5,
            locationXMax = 1.5,
            locationYChannel = 0.0,
            locationYMin = 0.0,
            locationYMax = 0.0,
            playbackSpeedByWidth = 0.0,
            phase = 0.5,
            translationIntensity = 1.0,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    vec2 defaultSize = getTextureSize('default);
    setShaderUniform('path, 'outputSize, defaultSize);
    setShaderUniform('path, 'time, getParameterFloat('renderFrameTimeSeconds));
    setShaderUniform('path, 'speed, getParameterFloat('speed));
    setShaderUniform('path, 'loop, getParameterFloat('loop));
    setShaderUniform('path, 'locationXChannel, getParameterFloat('locationXChannel));
    setShaderUniform('path, 'locationXMin, getParameterFloat('locationXMin));
    setShaderUniform('path, 'locationXMax, getParameterFloat('locationXMax));
    setShaderUniform('path, 'locationYChannel, getParameterFloat('locationYChannel));
    setShaderUniform('path, 'locationYMin, getParameterFloat('locationYMin));
    setShaderUniform('path, 'locationYMax, getParameterFloat('locationYMax));
    setShaderUniform('path, 'playbackSpeedByWidth, getParameterFloat('playbackSpeedByWidth));
    setShaderUniform('path, 'phase, getParameterFloat('phase));
    setShaderUniform('path, 'translationIntensity, getParameterFloat('translationIntensity));
}


# --- GLSL Shader (Path animation with transparent out-of-bounds sampling) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform vec2 outputSize;
    uniform float time;
    uniform float speed;
    uniform float loop;
    uniform float locationXChannel;
    uniform float locationXMin;
    uniform float locationXMax;
    uniform float locationYChannel;
    uniform float locationYMin;
    uniform float locationYMax;
    uniform float playbackSpeedByWidth;
    uniform float phase;
    uniform float translationIntensity;
    uniform sampler2D auxSampler1;

    vec4 sampleAnimation(sampler2D tex, float t, float channel) {
        vec2 uv1 = vec2(t, channel);
        vec4 samp1 = texture2D(tex, uv1);
        return samp1;
    }

    float map(float x, float lowIn, float highIn, float lowOut, float highOut) {
        if (highIn == lowIn) {
            return highIn;
        }
        float w = highIn - lowIn;
        x = x - lowIn;
        x /= w;
        float ow = highOut - lowOut;
        x *= ow;
        x += lowOut;
        return x;
    }

    float mapSimple(float x, float lowOut, float highOut) {
        return map(x, 0.0, 1.0, lowOut, highOut);
    }

    float byteCombine(vec2 v) {
        float highByte = v.r * 255.0;
        float lowByte = v.g * 255.0;
        float scaled = highByte * 256.0 + lowByte;
        float normalized = scaled / 65535.0;
        return normalized;
    }

    vec4 blendAlphaPremult(vec4 base, vec4 blend) {
        return blend + base * (1.0 - blend.a);
    }

    vec4 sampleInputClipped(vec2 uv) {
        vec4 color = sampleInput(uv);
        float inBounds = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
        return color * inBounds;
    }

    void main() {
        vec4 color = vec4(0.0);
        for (float i = 0.0; i < 2.0; i += 1.0) {
            float t = time * speed;
            float time_aspect = outputSize.x / outputSize.y;
            time_aspect = max(1.0, time_aspect);
            float aspect_corrected = t / time_aspect;
            aspect_corrected = max(1.0, aspect_corrected);
            t = mix(t, aspect_corrected, playbackSpeedByWidth);
            t += phase * i;
            float lt = fract(t);
            t = mix(t, lt, loop);

            vec4 locationx_sample = sampleAnimation(auxSampler1, t, locationXChannel);
            vec4 locationy_sample = sampleAnimation(auxSampler1, t, locationYChannel);

            float loc_x = byteCombine(locationx_sample.rg);
            loc_x = mapSimple(loc_x, locationXMin, locationXMax);
            float loc_y = byteCombine(locationy_sample.rg);
            loc_y = mapSimple(loc_y, locationYMin, locationYMax);

            vec2 aspect = vec2(1.0, outputSize.x / outputSize.y);
            vec2 uv = sourceTextureCoordinate;
            uv -= 0.5;
            uv /= aspect;
            uv -= vec2(loc_x, loc_y) * vec2(translationIntensity, -translationIntensity) * aspect;
            uv *= aspect;
            uv += 0.5;
            vec4 samp = sampleInputClipped(uv);
            color = blendAlphaPremult(color, samp * samp.a);
        }

        gl_FragColor = toOutputFormat(color);
    }
";
