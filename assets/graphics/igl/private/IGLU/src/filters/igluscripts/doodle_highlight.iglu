[Filter DoodleHighlight]
[MaskBehavior alpha]

# Post-processing filter for the Highlighter brush preset.
#
# Identical roughen pipeline to doodle_marker_roughen, intended to multiply the stroke against the
# media behind it so the highlighter darkens what it covers (T279813245). Separate from
# doodle_marker_roughen because BrushStrokeFilter keys one FilterLayer per renderFilterId: Marker and
# Highlighter would otherwise share a layer and a filter instance, so the blend cannot differ.
#
# The media is copied into a pass of its own so that compose takes only pass outputs as input. One
# input list cannot mix a preceding pass with a makeTexture() texture: with inputs = {'blurV, 'media}
# the pass runs and the media binds, but the index-0 input arrives empty and the stroke vanishes.
# Dropping makeTexture is not the way out either — an input that is neither a pass nor a declared
# texture makes IGLUScriptBuilder bail (FATAL returns early), which silently truncates the graph at
# that pass, so compose disappears and blurV becomes the output. copyMedia launders the one into the
# other, and its {'default, 'media} shape is the one doodle_pixelate_media already proves. T279813245.
#
# 8-pass pipeline: copyMedia, then noiseDisplace → dilateH → dilateV → erodeNoise → blurH → blurV,
# then compose({blurV, copyMedia}).

[Init]
fun init(Filter filter) {
  makeTexture('media);

  filter.parameters = {
    {displaceAmount = 0.002, min = 0.0, max = 0.01, description = "Edge Wobble"},
    {displaceScale = 21.17, min = 2.0, max = 30.0, description = "Wobble Scale"},
    {dilateRadius = 2.43, min = 0.0, max = 8.0, description = "Bleed Radius"},
    {toothAmount = 0.83, min = 0.0, max = 1.0, description = "Tooth Amount"},
    {toothScale = 27.07, min = 5.0, max = 40.0, description = "Tooth Scale"},
    {erodeRadius = 0.7, min = 0.0, max = 8.0, description = "Erode Radius"},
    {blurSamples = 1.0, min = 1.0, max = 16.0, description = "Blur Samples"},
    {blurStep = 1.5, min = 0.5, max = 8.0, description = "Blur Step"},
    {blurFalloff = 1.71, min = 0.1, max = 10.0, description = "Blur Falloff"},
    {blendMode = 2.0, min = 0.0, max = 3.0, description = "Blend (0=Normal 1=Multiply 2=Overlay 3=Screen)"},
    {dualBlendOpacity = 0.25, min = 0.0, max = 1.0, description = "Dual Blend Opacity"},
    {mediaTransform = identity4()},
  };

  filter.passes = {
  {
    name = 'copyMedia,
    inputs = {'default, 'media},
    uniforms = {
      mediaTransform = identity4(),
    },
    glslShader = copyMediaGlsl,
  },
  {
    name = 'noiseDisplace,
    inputs = {'default},
    uniforms = {
      outputSize = {1080.0, 1920.0},
      # The shader divides the displacement by contentAR, so this pass has to be given it. Left
      # unset it defaults to 0 and every sample coordinate becomes NaN, which smears the stroke
      # into a flat wash over the whole canvas instead of roughening its edges.
      contentAR = 0.5625,
      contentScale = {1.0, 1.0},
      displaceAmount = 0.002,
      displaceScale = 21.17,
    },
    glslShader = noiseDisplaceGlsl,
  },
  {
    name = 'dilateH,
    inputs = {'noiseDisplace},
    uniforms = {
      outputSize = {1080.0, 1920.0},
      axis = {1.0, 0.0},
      radius = 2.43,
    },
    glslShader = dilateGlsl,
  },
  {
    name = 'dilateV,
    inputs = {'dilateH},
    uniforms = {
      outputSize = {1080.0, 1920.0},
      axis = {0.0, 1.0},
      radius = 2.43,
    },
    glslShader = dilateGlsl,
  },
  {
    name = 'erodeNoise,
    inputs = {'dilateV},
    uniforms = {
      outputSize = {1080.0, 1920.0},
      contentAR = 0.5625,
      contentScale = {1.0, 1.0},
      toothAmount = 0.83,
      toothScale = 27.07,
      erodeRadius = 0.7,
    },
    glslShader = erodeNoiseGlsl,
  },
  {
    name = 'blurH,
    inputs = {'erodeNoise},
    uniforms = {
      inputSize = {1080.0, 1920.0},
      axis = {1.0, 0.0},
      numSamples = 1.0,
      blurStep = 1.5,
      falloffCurve = 1.71,
    },
    glslShader = blurGlsl,
  },
  {
    name = 'blurV,
    inputs = {'blurH},
    uniforms = {
      inputSize = {1080.0, 1920.0},
      axis = {0.0, 1.0},
      numSamples = 1.0,
      blurStep = 1.5,
      falloffCurve = 1.71,
    },
    glslShader = blurGlsl,
  },
  {
    # Both inputs are passes: 'blurV at index 0 (the roughened stroke) and 'copyMedia at index 1
    # (auxSampler1). The media is already mapped into stroke space by copyMedia.
    name = 'compose,
    inputs = {'blurV, 'copyMedia},
    uniforms = {
      blendMode = 2.0,
      dualBlendOpacity = 0.25,
    },
    glslShader = composeGlsl,
  }
  };
}

[PreRender]
fun preRender(Filter filter) {
  vec2 size = getTextureSize('default);

  f32 contentAR = getParameterFloat('contentAspectRatio);
  if (contentAR < 0.001) { contentAR = size.x / size.y; }
  vec2 contentScale = getParameterVec2('contentScale);
  if (contentScale.x < 0.001) { contentScale = {1.0, 1.0}; }

  f32 displaceAmount = getParameterFloat('displaceAmount);
  f32 displaceScale = getParameterFloat('displaceScale);
  f32 dilateRadius = getParameterFloat('dilateRadius);
  f32 toothAmount = getParameterFloat('toothAmount);
  f32 toothScale = getParameterFloat('toothScale);
  f32 erodeRadius = getParameterFloat('erodeRadius);
  f32 blurSamples = getParameterFloat('blurSamples);
  f32 blurStep = getParameterFloat('blurStep);
  f32 blurFalloff = getParameterFloat('blurFalloff);

  # Media copy pass
  setShaderUniform('copyMedia, 'mediaTransform, getParameterMat4('mediaTransform));

  # Noise displacement pass
  setShaderUniform('noiseDisplace, 'outputSize, size);
  setShaderUniform('noiseDisplace, 'contentAR, contentAR);
  setShaderUniform('noiseDisplace, 'contentScale, contentScale);
  setShaderUniform('noiseDisplace, 'displaceAmount, displaceAmount);
  setShaderUniform('noiseDisplace, 'displaceScale, displaceScale);

  # Dilate passes
  setShaderUniform('dilateH, 'outputSize, size);
  setShaderUniform('dilateH, 'radius, dilateRadius);
  setShaderUniform('dilateV, 'outputSize, size);
  setShaderUniform('dilateV, 'radius, dilateRadius);

  # Erode noise pass
  setShaderUniform('erodeNoise, 'outputSize, size);
  setShaderUniform('erodeNoise, 'contentAR, contentAR);
  setShaderUniform('erodeNoise, 'contentScale, contentScale);
  setShaderUniform('erodeNoise, 'toothAmount, toothAmount);
  setShaderUniform('erodeNoise, 'toothScale, toothScale);
  setShaderUniform('erodeNoise, 'erodeRadius, erodeRadius);

  # Blur passes
  setShaderUniform('blurH, 'inputSize, size);
  setShaderUniform('blurH, 'numSamples, blurSamples);
  setShaderUniform('blurH, 'blurStep, blurStep);
  setShaderUniform('blurH, 'falloffCurve, blurFalloff);
  setShaderUniform('blurV, 'inputSize, size);
  setShaderUniform('blurV, 'numSamples, blurSamples);
  setShaderUniform('blurV, 'blurStep, blurStep);
  setShaderUniform('blurV, 'falloffCurve, blurFalloff);

  # Compose pass
  f32 blendMode = getParameterFloat('blendMode);
  setShaderUniform('compose, 'blendMode, blendMode);
  f32 dualBlendOpacity = getParameterFloat('dualBlendOpacity);
  setShaderUniform('compose, 'dualBlendOpacity, dualBlendOpacity);
}

# ==========================================================================
# Pass 1: Media copy — resample the bound media into stroke space, so that the
# compose pass can take it as an ordinary pass input. 'default is unused here;
# it is declared only to hold index 0, which a declared texture cannot occupy.
# ==========================================================================
string copyMediaGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform sampler2D auxSampler1; // 'media — the upstream chain texture C++ binds by name
uniform mat4 mediaTransform;

void main() {
  // Map stroke-local UV into media space. Identity in the doodle editor, where the preview is the
  // full canvas; on playback the doodle is a transformed sticker and this is what keeps the
  // multiply reading the pixels actually behind the stroke. Y is flipped to match the media blit.
  vec2 mediaNdc = (mediaTransform * vec4(sourceTextureCoordinate * 2.0 - 1.0, 0.0, 1.0)).xy;
  vec2 mediaUV = mediaNdc * 0.5 + 0.5;
  vec4 media = texture2D(auxSampler1, vec2(mediaUV.x, 1.0 - mediaUV.y));

  gl_FragColor = toOutputFormat(vec4(media.rgb * media.a, media.a));
}
";

# ==========================================================================
# Pass 2: Noise displacement — organic edge wobble via Perlin noise UV offset
# cnoise() ported from doodle_wiggle.iglu
# ==========================================================================
string noiseDisplaceGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform vec2 outputSize;
uniform float contentAR;
uniform vec2 contentScale;
uniform float displaceAmount;
uniform float displaceScale;

vec4 permute(vec4 x) {
  return mod(((x*34.0)+1.0)*x, 289.0);
}

vec2 fade2(vec2 t) {
  return t*t*t*(t*(t*6.0-15.0)+10.0);
}

float cnoise(vec2 P) {
  vec4 Pi = floor(P.xyxy) + vec4(0.0, 0.0, 1.0, 1.0);
  vec4 Pf = fract(P.xyxy) - vec4(0.0, 0.0, 1.0, 1.0);
  Pi = mod(Pi, 289.0);
  vec4 ix = Pi.xzxz;
  vec4 iy = Pi.yyww;
  vec4 fx = Pf.xzxz;
  vec4 fy = Pf.yyww;
  vec4 i = permute(permute(ix) + iy);
  vec4 gx = 2.0 * fract(i * 0.0243902439) - 1.0;
  vec4 gy = abs(gx) - 0.5;
  vec4 tx = floor(gx + 0.5);
  gx = gx - tx;
  vec2 g00 = vec2(gx.x, gy.x);
  vec2 g10 = vec2(gx.y, gy.y);
  vec2 g01 = vec2(gx.z, gy.z);
  vec2 g11 = vec2(gx.w, gy.w);
  vec4 norm = 1.79284291400159 - 0.85373472095314 *
      vec4(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11));
  g00 *= norm.x;
  g01 *= norm.y;
  g10 *= norm.z;
  g11 *= norm.w;
  float n00 = dot(g00, vec2(fx.x, fy.x));
  float n10 = dot(g10, vec2(fx.y, fy.y));
  float n01 = dot(g01, vec2(fx.z, fy.z));
  float n11 = dot(g11, vec2(fx.w, fy.w));
  vec2 fade_xy = fade2(Pf.xy);
  vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);
  float n_xy = mix(n_x.x, n_x.y, fade_xy.y);
  return 2.3 * n_xy;
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  float aspect = contentAR;
  vec2 noiseCoord = vec2(uv.x * aspect * contentScale.x, uv.y * contentScale.y) * displaceScale;

  // Static noise (no time component) for consistent edge roughening
  float dx = cnoise(noiseCoord) * displaceAmount;
  float dy = cnoise(noiseCoord + vec2(43.21, 17.89)) * displaceAmount;

  vec4 color = sampleInput(uv + vec2(dx / aspect, dy));
  gl_FragColor = toOutputFormat(color);
}
";

# ==========================================================================
# Pass 3-4: Separable 1D max dilation — ink bleed (from doodle_neon.iglu)
# ==========================================================================
string dilateGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform vec2 outputSize;
uniform vec2 axis;
uniform float radius;

#define MAX_RADIUS 8

vec4 dilate(vec2 uv, vec2 pixel) {
  vec4 c = vec4(0.0);

  for (int i = -MAX_RADIUS; i <= MAX_RADIUS; ++i) {
    vec4 v = sampleInput(uv + pixel * float(i));
    c = max(c, v);
  }
  return c;
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec2 duv = axis / outputSize;
  vec4 color = dilate(uv, radius * duv / float(MAX_RADIUS));

  gl_FragColor = toOutputFormat(color);
}
";

# ==========================================================================
# Pass 5: Noise-modulated erosion — paper tooth texture gaps
# Min-value kernel with Perlin noise masking to create organic holes in fill
# ==========================================================================
string erodeNoiseGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform vec2 outputSize;
uniform float contentAR;
uniform vec2 contentScale;
uniform float toothAmount;
uniform float toothScale;
uniform float erodeRadius;

#define MAX_RADIUS 8

vec4 permute(vec4 x) {
  return mod(((x*34.0)+1.0)*x, 289.0);
}

vec2 fade2(vec2 t) {
  return t*t*t*(t*(t*6.0-15.0)+10.0);
}

float cnoise(vec2 P) {
  vec4 Pi = floor(P.xyxy) + vec4(0.0, 0.0, 1.0, 1.0);
  vec4 Pf = fract(P.xyxy) - vec4(0.0, 0.0, 1.0, 1.0);
  Pi = mod(Pi, 289.0);
  vec4 ix = Pi.xzxz;
  vec4 iy = Pi.yyww;
  vec4 fx = Pf.xzxz;
  vec4 fy = Pf.yyww;
  vec4 i = permute(permute(ix) + iy);
  vec4 gx = 2.0 * fract(i * 0.0243902439) - 1.0;
  vec4 gy = abs(gx) - 0.5;
  vec4 tx = floor(gx + 0.5);
  gx = gx - tx;
  vec2 g00 = vec2(gx.x, gy.x);
  vec2 g10 = vec2(gx.y, gy.y);
  vec2 g01 = vec2(gx.z, gy.z);
  vec2 g11 = vec2(gx.w, gy.w);
  vec4 norm = 1.79284291400159 - 0.85373472095314 *
      vec4(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11));
  g00 *= norm.x;
  g01 *= norm.y;
  g10 *= norm.z;
  g11 *= norm.w;
  float n00 = dot(g00, vec2(fx.x, fy.x));
  float n10 = dot(g10, vec2(fx.y, fy.y));
  float n01 = dot(g01, vec2(fx.z, fy.z));
  float n11 = dot(g11, vec2(fx.w, fy.w));
  vec2 fade_xy = fade2(Pf.xy);
  vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);
  float n_xy = mix(n_x.x, n_x.y, fade_xy.y);
  return 2.3 * n_xy;
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec2 pixel = vec2(1.0) / outputSize;
  float aspect = contentAR;

  // Perlin noise for tooth mask — high-frequency for fine grain
  vec2 noiseCoord = vec2(uv.x * aspect, uv.y) * toothScale;
  float noise = cnoise(noiseCoord) * 0.5 + 0.5; // remap to 0..1

  // Noise-modulated erosion radius: where noise is high, erode more
  float effectiveRadius = erodeRadius * mix(1.0, noise, toothAmount);
  vec2 step = pixel * effectiveRadius / float(MAX_RADIUS);

  // Min-value kernel (erosion) — only along both axes for speed
  vec4 c = sampleInput(uv);
  for (int i = -MAX_RADIUS; i <= MAX_RADIUS; ++i) {
    c = min(c, sampleInput(uv + vec2(step.x * float(i), 0.0)));
    c = min(c, sampleInput(uv + vec2(0.0, step.y * float(i))));
  }

  gl_FragColor = toOutputFormat(c);
}
";

# ==========================================================================
# Pass 6-7: Separable Gaussian blur — edge smoothing (from doodle_neon.iglu)
# ==========================================================================
string blurGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform vec2 inputSize;
uniform vec2 axis;
uniform float numSamples;
uniform float blurStep;
uniform float falloffCurve;

void main() {
  vec4 texel = vec4(0.0);
  float totalWeight = 0.0;

  vec2 dir = axis / inputSize;

  for (float i = 0.0; i < 64.0; i++) {
    if (i >= numSamples) break;

    float offset = (i - (numSamples - 1.0) / 2.0) * blurStep;
    float weight = exp(-abs(offset) * falloffCurve / numSamples);

    vec2 sampleCoord = sourceTextureCoordinate + dir * offset;
    texel += sampleInput(sampleCoord) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(texel / totalWeight);
}
";

# ==========================================================================
# Pass 8: Compose — blend roughened stroke with background media
# Supports Normal, Multiply, Overlay, Screen blend modes
# Background media arrives via the 'media input as auxSampler1 / tex1
# ==========================================================================
string composeGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform sampler2D auxSampler1; // 'copyMedia — the pixels behind the stroke, in stroke space
uniform float blendMode;
uniform float dualBlendOpacity;

vec3 blendMultiply(vec3 base, vec3 blend) {
  return base * blend;
}

vec3 blendScreen(vec3 base, vec3 blend) {
  return 1.0 - (1.0 - base) * (1.0 - blend);
}

vec3 blendOverlay(vec3 base, vec3 blend) {
  return mix(
    2.0 * base * blend,
    1.0 - 2.0 * (1.0 - base) * (1.0 - blend),
    step(0.5, base)
  );
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 stroke = sampleInput(uv);

  // No stroke — fully transparent
  if (stroke.a < 0.001) {
    gl_FragColor = toOutputFormat(vec4(0.0));
    return;
  }

  vec4 media = texture2D(auxSampler1, uv);

  // No media — pass stroke through as-is (normal drawing without background)
  if (media.a < 0.001) {
    gl_FragColor = toOutputFormat(stroke);
    return;
  }

  // Unpremultiply both; copyMedia wrote its output premultiplied like every other pass
  vec3 strokeRGB = stroke.rgb / stroke.a;
  vec3 mediaRGB = media.rgb / media.a;

  // Apply blend mode (rounded to nearest int)
  int mode = int(floor(blendMode + 0.5));
  vec3 result = strokeRGB;
  if (mode == 1) {
    result = blendMultiply(mediaRGB, strokeRGB);
  } else if (mode == 2) {
    result = blendOverlay(mediaRGB, strokeRGB);
  } else if (mode == 3) {
    result = blendScreen(mediaRGB, strokeRGB);
  }

  // Layer normal blend on top if dualBlendOpacity > 0
  if (dualBlendOpacity > 0.0) {
    result = mix(result, strokeRGB, dualBlendOpacity);
  }

  // Output premultiplied with stroke alpha
  gl_FragColor = toOutputFormat(vec4(result * stroke.a, stroke.a));
}
";
