[Filter IgluscriptVideoGridExpandFilter]



[Init]
fun init(Filter filter) {
  filter.passes = {{
      name = 'grid_expand, inputs = {'default},
      uniforms = {
        progress = 0.0,
      },
      glslShader = glsl
    }};
}

[PreRender]
fun preRender(Filter filter) {
  # Get behavior parameters from parameter map (set by JNI/keyframe system)
  f32 progressValue = getParameterFloat('progress);

  # Apply to shader uniform
  setShaderUniform('grid_expand, 'progress, progressValue);
}

string glsl = "precision highp float;

varying vec2 textureCoordinate;
varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float progress;

void main() {

vec2 uv = sourceTextureCoordinate;

float s1 = step(1.0/4.0, progress);
float s2 = step(2.0/4.0, progress);
float s3 = step(3.0/4.0, progress);

vec2 subD = vec2(1.0 + s2 + s3, 1.0 + s1 + s3);

vec2 localUV = fract(uv * subD);

float vertGrid = s1 - s2;
localUV.y = mix(localUV.y, localUV.y * 0.5 + 0.25, vertGrid);


  vec4 color = sampleInput(localUV);
  gl_FragColor = toOutputFormat(color);
}
";
