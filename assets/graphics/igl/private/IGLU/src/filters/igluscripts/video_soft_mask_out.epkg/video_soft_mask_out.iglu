[Filter VideoSoftMaskOut]
# Soft Mask transition effect — horizontal soft wipe with bidirectional support.
# Outro version of VideoSoftMask — reuses same shaders with outro=1.
#
# Single-pass pipeline:
#   pass0: smoothstep-based horizontal soft mask, direction controlled by `outro`
#
# outro = 1 → "Soft Mask Out" (content disappears to right)

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {duration = 2.0, min = 1.0, max = 5.0, description = "Duration"},
        {intensity = 0.3, min = 0.01, max = 1.0, description = "Softness"},
    };

    filter.passes = {
        {
            name = 'pass0,
            inputs = {'default},
            uniforms = {
                progress = 0.0,
                ramp = 0.3,
                outro = 1.0,
            },
            glslShader = glslSoftMask,
            metalShader = metalSoftMask,
        },
    };
}

[PreRender]
fun preRender(Filter filter) {
    setShaderUniform('pass0, 'progress, getParameterFloat('progress));
    setShaderUniform('pass0, 'ramp, getParameterFloat('intensity));
}

string glslSoftMask = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    uniform float progress;
    uniform float ramp;
    uniform float outro;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec4 samp = sampleInput(uv);
        float p = progress * (1.0 + ramp * 2.0);
        p -= ramp;
        float a_out = smoothstep(-ramp * 0.5, ramp * 0.5, uv.x - p);
        float a_in = smoothstep(ramp * 0.5, -ramp * 0.5, uv.x - p);

        float a = mix(a_in, a_out, step(0.5, outro));
        samp *= a;
        gl_FragColor = toOutputFormat(samp);
    }
";

string metalSoftMask = "
    struct fragmentOut { float4 _gl_FragColor [[color(0)]]; };
    struct fragmentIn { float2 sourceTextureCoordinate [[user(locn1)]]; };

    typedef struct {
        BaseUniformsMetal;
        float progress;
        float ramp;
        float outro;
    } Uniforms;

    fragment fragmentOut fragmentShader(fragmentIn in [[stage_in]],
                                        constant Uniforms & uniforms [[buffer(1)]],
                                        DefaultInputs defaultInputs
                                        ) {
        float2 uv = in.sourceTextureCoordinate;
        float4 samp = sampleInput(defaultInputs, uv);
        float p = uniforms.progress * (1.0 + uniforms.ramp * 2.0);
        p -= uniforms.ramp;
        float a_out = smoothstep(-uniforms.ramp * 0.5, uniforms.ramp * 0.5, uv.x - p);
        float a_in = smoothstep(uniforms.ramp * 0.5, -uniforms.ramp * 0.5, uv.x - p);

        float a = mix(a_in, a_out, step(0.5, uniforms.outro));
        samp *= a;
        fragmentOut out = {};
        out._gl_FragColor = toOutputFormat(samp);
        return out;
    }
";
