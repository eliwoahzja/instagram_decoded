[Filter BlackII]
# "Black II" — LUT color grading + radial vignette.
#
# Single-pass IGLUScript. The LUT half is identical to black_and_white /
# spark_soft_nature (8x8 grid trilinear sampling). The vignette half is a
# standard radial darkening computed from distance to UV center.
#
# LUT delivered via ARD (effectId / assetHash filled in once provided —
# TODO placeholders in the manifest until then).
#
# Lighting emulation:
#   Spark scene used 20% ambient + 80% directional, both pure white.
#   On a flat plane facing the directional light, that math reduces to
#   color * (0.2 + 0.8 * dot(N, L)) = color * (0.2 + 0.8 * 1.0) = color * 1.0
#   i.e. a no-op at default. The `brightness` uniform below makes that
#   knob explicit so it can be tuned at runtime via Custom Parameters
#   without recompiling.
#
# Vignette math (per pixel):
#   d = length(uv - 0.5) * sqrt(2.0)            // 0 at center, 1 at corners
#   v = smoothstep(1 - vignette_softness, 1.0, d)
#   darkness = 1 - v * vignette_strength
#   out.rgb = lutGraded.rgb * darkness
# Defaults (post visual A/B vs Spark editor):
#   strength = 1.0           — LUT mix at full strength.
#   brightness = 1.025       — slight global lift (~2.5%) tuned in sample app
#                              against Spark editor reference frames.
#   vignette_strength = 0.52 — corners ~52% darker than center.
#   vignette_softness = 0.605 — falloff occupies ~60% of the frame radius.
# All four are 0..1 (brightness 0..2), wired unconditionally in [PreRender]
# so host-set 0.0 is respected.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    # Host-tunable parameters. All have valid 0.0 minimums; we wire them
    # unconditionally in [PreRender] so a host-set 0.0 takes effect (per CRA
    # findings on black_and_white — guarded sets blocked legitimate zeros).
    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {brightness = 1.025, min = 0.0, max = 2.0, description = "Output brightness (Spark scene-light emulation)"},
        {vignette_strength = 0.52, min = 0.0, max = 1.0, description = "Vignette darkness at corners (0 = none, 1 = pure black)"},
        {vignette_softness = 0.605, min = 0.0, max = 1.0, description = "Vignette gradient width (0 = hard edge, 1 = full-frame falloff)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        strength = 1.0,
        brightness = 1.025,
        vignette_strength = 0.52,
        vignette_softness = 0.605,
      },
      glslShader = glslLutVignette,
    }};
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    # All four parameters wired unconditionally — filter.parameters declares
    # min=0.0 for each, so host-set zeros are valid input and must propagate.

    # LUT mix strength
    f32 s = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, s);

    # Spark scene-light emulation (default 1.0 = no-op)
    f32 b = getParameterFloat('brightness);
    setShaderUniform('pass0, 'brightness, b);

    # Vignette knobs
    f32 vs = getParameterFloat('vignette_strength);
    setShaderUniform('pass0, 'vignette_strength, vs);
    f32 vsoft = getParameterFloat('vignette_softness);
    setShaderUniform('pass0, 'vignette_softness, vsoft);
}

#### GLSL shader ####

string glslLutVignette = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float brightness;
    uniform float vignette_strength;
    uniform float vignette_softness;

    void main() {
      vec2 uv = sourceTextureCoordinate;

      // --- Layer 1: LUT color grading (same shader as black_and_white) ---
      vec4 texel = sampleInput(uv);

      texel.rgb = clamp(texel.rgb, 0.00781, 0.98438);

      float x = texel.r / 8.0;
      float y = texel.g / 8.0;
      float z = texel.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      texel = mix(texel, vec4(color, texel.a), strength);

      // Spark scene-light emulation: ambient(0.2) + directional(0.8) white,
      // collapsed to a single brightness multiplier on a flat plane. Default 1.0.
      texel.rgb *= brightness;

      // --- Layer 2: radial vignette ---
      // d normalized so center=0, corners=1.0. sqrt(2) ≈ 1.4142 because
      // length(vec2(0.5,0.5)) = 0.7071, and we want corner distance = 1.0.
      float d = length(uv - vec2(0.5)) * 1.4142;

      // smoothstep from (1 - softness) to 1.0 produces a falloff that
      // occupies the outer `softness` fraction of the radial range.
      // softness=0 → step at d=1.0 (no visible vignette).
      // softness=1 → smooth ramp from center to corner (broadest).
      float v = smoothstep(1.0 - vignette_softness, 1.0, d);

      // darkness multiplier in [1 - vignette_strength, 1.0].
      // strength=0 → no darkening; strength=1 → corners fully black.
      float darkness = 1.0 - v * vignette_strength;
      texel.rgb *= darkness;

      gl_FragColor = toOutputFormat(texel);
    }
    ";
