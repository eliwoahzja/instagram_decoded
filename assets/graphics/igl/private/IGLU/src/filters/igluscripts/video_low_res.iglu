[Filter IgluscriptVideoLowResFilter]

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {amount = 0.33, min = 0.0, max = 1.0}
  };

  filter.passes = {{
      name = 'low_res, inputs = {'default},
      uniforms = {
        inputSize = {1080.0, 1920.0},
        blockSize = 5.0,
        maxColors = 256.0,
        aberration = 0.004,
      },
      glslShader = glsl
    }};
}

fun getSizeScale() f32 {
  vec2 inputSize = getTextureSize('default);
  return min(inputSize.x, inputSize.y) / 1080.0;
}

[PreRender]
fun preRender(Filter filter) {
  vec2 inputSize = getTextureSize('default);
  setShaderUniform('low_res, 'inputSize, inputSize);

  f32 sizeScale = getSizeScale();
  f32 blockSizeBase = 5.0;
  f32 blockSize = blockSizeBase * sizeScale;
  setShaderUniform('low_res, 'blockSize, blockSize);

  # Amount (0..1) mapped so that the default 0.33 projects to maxColors = 256
  f32 maxColors = 128.0 + (getParameterFloat('amount) / 0.33) * 128.0;
  setShaderUniform('low_res, 'maxColors, maxColors);
}

string glsl = "
varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float blockSize;
uniform float maxColors;
uniform float aberration;
uniform vec2 inputSize;

void main() {

  vec2 uv = sourceTextureCoordinate;

  vec2 st = (uv - 0.5) * inputSize;
  vec2 pixelatedST = floor(st / blockSize) * blockSize + blockSize * 0.5;
  vec2 pixelatedUV = pixelatedST / inputSize + 0.5;

  vec4 baseR = sampleInput(pixelatedUV + aberration);
  vec4 baseG = sampleInput(pixelatedUV);
  vec4 baseB = sampleInput(pixelatedUV - aberration);
  vec4 base = vec4(baseR.r, baseG.g, baseB.b, baseR.a);

  // 8-bit color
  vec3 color_resolution = vec3(8.0, 8.0, 4.0) * maxColors / 256.0;
  vec3 color_bands = floor(base.rgb * color_resolution) / (color_resolution - 1.0);
  vec4 color = vec4(min(color_bands, 1.0), base.a);

  gl_FragColor = toOutputFormat(color);
}
";
