[Filter FeelWithReel]
# "Feel with Reel" — vintage film look ported from the Spark AR effect
# (effectId 1343380249562979). Single fragment pass composing, bottom -> top:
#
#   Layer 1 — Base LUT color grade (full canvas)
#     Standard 8x8 grid LUT lookup on the camera. Falls back to camera
#     passthrough when the LUT texture is not yet loaded (WIP / pre-ARD).
#
#   Layer 2 — Contrast darkening
#     Approximates the source effect's camera self-multiply (raw camera
#     multiplied over the grade at ~0.4). Implemented as
#     mix(graded, graded*graded, contrast_strength) — no extra pass.
#
#   Layer 3 — Animated dust specks (full canvas, procedural)
#     Cell-grid pseudo-random dark specks cycling at dust_fps (~6 fps to
#     match the source's 6 fps dust sequence). Composited as a multiply
#     darken at dust_opacity.
#
#   Layer 4 — Film scratches + occasional hairs (procedural)
#     Per-frame thin vertical stripes (some dashed, like a film frame
#     edge) plus a couple of low-probability curved "hair" strands.
#     Subtract/darken blend at scratch_opacity.
#
#   Layer 5 — Film grain (procedural)
#     Discrete 3-frame hash grain, screen blend at grain_opacity.
#
#   Layer 6 — Film-strip overlay (bundled PNG)
#     Left-edge sprocket-hole film strip. Alpha blended over the result
#     at overlay_opacity. Bound via named input 'overlay; sample-app
#     local file supplied through the overlay_path string param.
#
# Face-tracking (skin smoothing + makeup) from the source effect is
# intentionally dropped: it is not a core/visible part of this effect, so
# this ships as a pure full-screen IGLUScript filter (Remote release path).
#
# Assets live in igluscripts/assets/feel_with_reel/ (the upload script's
# discovery scans there). Time source: getLocalTime() (monotonic
# wall-clock) for continuous animation. GLSL only — Metal is generated by
# the runtime GLSL->Metal compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);
    makeTexture('overlay);

    filter.parameters = {
        # Layer 1 LUT.
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength (1.0 = full LUT, 0.0 = camera passthrough)"},

        # Layer 2 contrast darkening.
        {contrast_strength = 0.4, min = 0.0, max = 1.0, description = "Film contrast/darkening (self-multiply) amount"},

        # Layer 3 dust.
        {dust_opacity = 0.305, min = 0.0, max = 1.0, description = "Animated dust speck multiply-darken opacity"},
        {dust_density = 1.0, min = 0.0, max = 1.0, description = "Dust speck density (0 = sparse, 1 = dense)"},
        {dust_fps = 2.165, min = 1.0, max = 30.0, description = "Dust/scratch animation frame rate"},

        # Layer 4 scratches.
        {scratch_opacity = 0.056, min = 0.0, max = 1.0, description = "Vertical scratch + hair subtract-darken opacity"},

        # Layer 5 grain.
        {grain_opacity = 0.12, min = 0.0, max = 1.0, description = "Procedural grain screen-blend opacity"},

        # Layer 6 overlay.
        {overlay_opacity = 0.938, min = 0.0, max = 1.0, description = "Film-strip overlay alpha-blend opacity"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut, 'overlay},
      uniforms = {
        lut_strength = 1.0,
        contrast_strength = 0.4,
        dust_opacity = 0.305,
        dust_density = 1.0,
        dust_fps = 2.165,
        scratch_opacity = 0.056,
        grain_opacity = 0.12,
        overlay_opacity = 0.938,
        time = 0.0,
      },
      glslShader = glslFeelWithReel,
    }};
}

# Custom Parameter strings for sample-app local-loading. Production wiring
# uses the Hub-delivered assets bound as the named inputs; sample-app
# testing overrides via these textureFilePath:// paths (or the Named Inputs
# panel's OS file picker on the 'lut / 'overlay ports).
string lut_path = "lut_path";
string lut_filename = "";
string overlay_path = "overlay_path";
string overlay_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    string overlay_filename_parameter = getParameterString(overlay_path);
    if (overlay_filename_parameter != "") {
        string new_overlay_filename = stringAppend("textureFilePath://", overlay_filename_parameter);
        if (new_overlay_filename != overlay_filename) {
            overlay_filename = new_overlay_filename;
            loadTexture('overlay, overlay_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 cs = getParameterFloat('contrast_strength);
    setShaderUniform('pass0, 'contrast_strength, cs);

    f32 dop = getParameterFloat('dust_opacity);
    setShaderUniform('pass0, 'dust_opacity, dop);

    f32 dde = getParameterFloat('dust_density);
    setShaderUniform('pass0, 'dust_density, dde);

    f32 dfp = getParameterFloat('dust_fps);
    setShaderUniform('pass0, 'dust_fps, dfp);

    f32 sop = getParameterFloat('scratch_opacity);
    setShaderUniform('pass0, 'scratch_opacity, sop);

    f32 gop = getParameterFloat('grain_opacity);
    setShaderUniform('pass0, 'grain_opacity, gop);

    f32 oop = getParameterFloat('overlay_opacity);
    setShaderUniform('pass0, 'overlay_opacity, oop);

    # Use getLocalTime() for monotonic continuous animation.
    f32 time = getLocalTime();
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslFeelWithReel = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lut
    uniform sampler2D auxSampler2;  // 'overlay (film strip)

    uniform float lut_strength;
    uniform float contrast_strength;
    uniform float dust_opacity;
    uniform float dust_density;
    uniform float dust_fps;
    uniform float scratch_opacity;
    uniform float grain_opacity;
    uniform float overlay_opacity;
    uniform float time;

    // 1D pseudo-random hash.
    float hash11(float x) {
      return fract(sin(x * 12.9898) * 43758.5453);
    }

    // 2D pseudo-random hashes.
    float hash21(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }
    vec2 hash22(vec2 p) {
      return fract(sin(vec2(dot(p, vec2(127.1, 311.7)),
                            dot(p, vec2(269.5, 183.3)))) * 43758.5453);
    }

    // 8x8 grid LUT lookup on auxSampler1.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    // Cell-grid dark dust specks. Returns coverage in [0, 1].
    float dustSpecks(vec2 uv, float frame_seed, float density) {
      float grid_scale = 30.0 + density * 40.0;
      vec2 off = vec2(frame_seed * 13.7, frame_seed * 7.3);
      vec2 g = floor(uv * grid_scale + off);
      vec2 cell = fract(uv * grid_scale + off);
      vec2 rp = hash22(g);
      float has = step(1.0 - density * 0.5, hash21(g + frame_seed));
      float d = distance(cell, rp);
      float sz = 0.06 + hash21(g + vec2(1.7)) * 0.12;
      return clamp(has * smoothstep(sz, 0.0, d), 0.0, 1.0);
    }

    // Distance-based thin curved strand (film hair). Returns coverage.
    float hairAt(vec2 uv, vec2 anchor, float ang, float len,
                 float freq, float amp, float th) {
      vec2 local = uv - anchor;
      float c = cos(ang);
      float s = sin(ang);
      vec2 rot = vec2(local.x * c + local.y * s,
                      -local.x * s + local.y * c);
      if (rot.x < 0.0 || rot.x > len) return 0.0;
      float cy = sin(rot.x * freq) * amp;
      return smoothstep(th, 0.0, abs(rot.y - cy));
    }

    // Per-frame vertical scratches (some dashed) + occasional hairs.
    float scratchField(vec2 uv, float frame_idx) {
      float a = 0.0;
      float fseed = frame_idx * 7.31 + 0.137;

      // 0-4 thin vertical stripes.
      for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float exists = step(0.45, hash11(fseed * 11.7 + fi * 3.13));
        float x = hash11(fseed * 13.31 + fi * 19.71);
        float w = 0.0012 + 0.0016 * hash11(fseed * 19.7 + fi * 13.13);
        float dx = abs(uv.x - x);
        // Dashed break-up along Y so stripes read like a film frame edge.
        float dash = step(0.35, fract(uv.y * 40.0 + hash11(fseed + fi) * 10.0));
        // Vertical lines kept subtler (0.5) than the dust/hairs.
        a += 0.5 * exists * step(dx, w) * mix(1.0, dash, 0.4);
      }

      // 0-2 low-probability hair strands.
      for (int j = 0; j < 2; j++) {
        float fj = float(j);
        vec2 anchor = hash22(vec2(fseed * 3.1 + fj * 7.3, fj * 11.7));
        float ang = hash11(fseed * 5.0 + fj) * 6.2831853;
        float len = 0.06 + hash11(fseed * 7.0 + fj) * 0.14;
        float freq = 25.0 + hash11(fseed * 9.0 + fj) * 80.0;
        float amp = 0.004 + hash11(fseed * 11.0 + fj) * 0.010;
        float vis = step(0.70, hash11(fseed * 13.0 + fj));
        a += vis * hairAt(uv, anchor, ang, len, freq, amp, 0.0012);
      }

      return clamp(a, 0.0, 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;

      // ============================================================
      // Layer 1: LUT-graded camera with empty-LUT fallback.
      // ============================================================
      vec4 cam = sampleInput(uv);
      vec3 lut_rgb = lutLookup(cam.rgb);
      vec3 lut_probe = texture2D(auxSampler1, vec2(0.5, 0.5)).rgb;
      float lut_loaded = step(0.05,
          max(max(lut_probe.r, lut_probe.g), lut_probe.b));
      vec3 result = mix(cam.rgb, lut_rgb, lut_strength * lut_loaded);

      // ============================================================
      // Layer 2: Contrast darkening (approx camera self-multiply).
      // ============================================================
      result = mix(result, result * result, contrast_strength);

      // ============================================================
      // Layer 3: Animated dust specks (multiply darken) at dust_fps.
      // Frame index is wrapped into a 16-frame loop so the hash seed
      // stays small — an unbounded floor(time*fps) grows until sin()
      // loses precision and the specks/scratches silently vanish
      // (worse the higher the fps).
      // ============================================================
      float dframe = mod(floor(time * dust_fps), 16.0);
      float dust = dustSpecks(uv, dframe, dust_density);
      result = mix(result, result * (1.0 - dust), dust_opacity);

      // ============================================================
      // Layer 4: Vertical scratches + hairs (subtract darken).
      // ============================================================
      float scratch = scratchField(uv, dframe);
      result = clamp(result - vec3(scratch * scratch_opacity), 0.0, 1.0);

      // ============================================================
      // Layer 5: Procedural grain (screen blend), 3-frame loop @ 7fps.
      // ============================================================
      float gframe = mod(floor(time * 7.0), 3.0);
      float grain = fract(sin(uv.x * 127.1 + uv.y * 311.7 + gframe * 74.3)
                          * 43758.5453);
      vec3 screened = vec3(1.0) - (vec3(1.0) - result)
                      * (vec3(1.0) - vec3(grain));
      result = mix(result, screened, grain_opacity);

      // ============================================================
      // Layer 6: Film-strip overlay (alpha blend).
      // ============================================================
      vec4 ov = texture2D(auxSampler2, uv);
      result = mix(result, ov.rgb, ov.a * overlay_opacity);

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
