[Filter IgluscriptVideoSlamDownFilter]
[MaskBehavior alpha]

fun mix(f32 a, f32 b, f32 t) f32 {
  return a * (1.0 - t) + b * t;
}

# Strong ease-out: 90% of transition in first 1/3
fun slamEase(f32 t) f32 {
  f32 u = 1.0 - t;
  return 1.0 - pow(u,12.0);
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {center = {0.5, 0.5}, min = {0.0, 0.0}, max = {1.0, 1.0}},
    {outro = 0.0, min = 0.0, max = 1.0, description = "0 = In, 1 = Out"},
    {size = 0.45, min = 0.0, max = 1.0, description = "Starting Scale"},
  };

  filter.passes = {{
      name = 'scaleFx,
      igid = 'video_scale_opacity,
      inputs = {'default},
      uniforms = {
        progress = 0.0,
        scale = 1.2,
        opacity = 0.0,
        center = {0.5, 0.5},
      }
    }};
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  f32 outro = getParameterFloat('outro);
  if (outro > 0.5) { p = 1.0 - p; }
  p = slamEase(p);

  f32 size = mix(1.1, 2.0, getParameterFloat('size));
  f32 scale = mix(size, 1.0, p);
  f32 opacity = clamp(p * 10.0, 0.0, 1.0);

  setShaderUniform('scaleFx, 'progress, p);
  setShaderUniform('scaleFx, 'scale, scale);
  setShaderUniform('scaleFx, 'opacity, opacity);
  setShaderUniform('scaleFx, 'center, getParameterVec2('center));
}
