[Filter IgluscriptNeonBloomFilter]
[MaskBehavior alpha]

[Init]
fun init(Filter filter) {

  filter.parameters = {
    {intensity = 1.0, min = 0.0, max = 1.0, description = "Intensity"},
    {amount = 0.5, min = 0.0, max = 1.0, description = "Amount"},
    {bloom_radius    = 1.0, min = 0.0, max = 1.0, description = "Bloom Radius"},
    {color    = {0.5490, 0.1765, 0.72, 1.0}, description = "Bloom Color"},
  };

  filter.passes = {
  {
    name = 'color_adjust,
    inputs = {'default},
    uniforms = {
      shadowColor = {0.1765, 0.0510, 0.1765},
      midtoneColor = {0.4275, 0.2863, 0.4980},
      highlightColor = {0.9294, 0.7765, 1.0000},
      strength = 0.2,
      blendMode = 0.0,
    },
    glslShader = tritoneShader,
  },
  {
    name = 'threshold,
    inputs = {'color_adjust},
    uniforms = {
      threshold = 0.55,
      feather = 0.2,
      darken = 1.0,
    },
    glslShader = thresholdGlsl,
  },
  {
      name = 'verticalPass,
      inputs = {'threshold},
      scale = {0.5, 0.5},
      uniforms = {
        strength = 1.0,
        sigma = 20.0,
        kernelSize = 40.0,
        blurStep = {1.0,0.0}, # H or V step size
        invTotalWeight = 1.0, # scaling
        dda = {1.0,1.0,1.0}, # used to compute powers
      },
      glslShader  = glslSeparableBlur,
    },
    {
      name = 'horizontalPass,
      inputs = {'verticalPass},
      scale = {0.5, 0.5},
      uniforms = {
        strength = 1.0,
        sigma = 20.0,
        kernelSize = 40.0,
        blurStep = {0.0,1.0}, # H or V step size
        invTotalWeight = 1.0, # scaling
        dda = {1.0,1.0,1.0},  # used to compute powers
      },
      glslShader  = glslSeparableBlur,
    },
      {
      name = 'verticalPassB,
      inputs = {'horizontalPass},
      scale = {0.25, 0.25},
      uniforms = {
        strength = 1.0,
        sigma = 20.0,
        kernelSize = 40.0,
        blurStep = {1.0,0.0}, # H or V step size
        invTotalWeight = 1.0, # scaling
        dda = {1.0,1.0,1.0}, # used to compute powers
      },
      glslShader  = glslSeparableBlur,
    },
    {
      name = 'horizontalPassB,
      inputs = {'verticalPassB},
      scale = {0.25, 0.25},
      uniforms = {
        strength = 1.0,
        sigma = 20.0,
        kernelSize = 40.0,
        blurStep = {0.0,1.0}, # H or V step size
        invTotalWeight = 1.0, # scaling
        dda = {1.0,1.0,1.0},  # used to compute powers
      },
      glslShader  = glslSeparableBlur,
    },
  {
    name = 'composite,
    inputs = {'default, 'horizontalPassB},
    uniforms = {
      exposure = 0.75,
      saturation = 0.85,
      tintColor = {1.0, 1.0, 1.0},
      bloomTintColor = {0.5490, 0.1765, 0.72}
    },
    glslShader  = compositeGlsl,
  }
  };
}

f32 lastKernelSize = -1.0;
f32 lastSigma = -1.0;
vec2 lastOutputSize = {-1.0,-1.0};

# One texel of the 0.5-scale pass pair is 2 full-res pixels; one texel of the
# 0.25-scale pair is 4. The bilinear pairing in glslSeparableBlur is only exact
# when consecutive taps are adjacent texels of the pass's own render target, so
# each stage gets its own step vector.
vec2 dV2 = {1.0,1.0};
vec2 dH2 = {1.0,1.0};
vec2 dV4 = {1.0,1.0};
vec2 dH4 = {1.0,1.0};

f32 sigmaA = 1.0;
f32 kernelSizeA = 1.0;
f32 invTotalWeightA = 1.0;
vec3 forwardDifferencerA = {1.0,1.0,1.0};

f32 sigmaB = 1.0;
f32 kernelSizeB = 1.0;
f32 invTotalWeightB = 1.0;
vec3 forwardDifferencerB = {1.0,1.0,1.0};

# Gaussian weight block for one blur stage, returned as
# {invTotalWeight, dda.x, dda.y, dda.z}. sigma and kernelSize must both be
# expressed in the stage's own step units.
fun gaussianWeights(f32 sigma, f32 kernelSize) vec4 {
  f32 totalWeight = 0.0;
  f32 pow1 = exp(-0.5/(sigma*sigma));
  f32 i = -kernelSize;
  while (i <= kernelSize)
  {
    totalWeight = totalWeight + pow(pow1,i*i);
    i = i + 1.0;
  }
  vec4 block = {1.0/totalWeight, pow1*pow1, pow1*pow1*pow1, pow1};
  return block;
}

[PreRender]
fun preRender(Filter filter){

  f32 intensity = getParameterFloat('intensity);
  f32 amount = getParameterFloat('amount);

  # composite-stage sliders
  setShaderUniform('composite, 'exposure,  intensity);

  vec3 color = getParameterVec3('color);
  setShaderUniform('composite, 'bloomTintColor, color);

  vec2 outputSize = getTextureSize('default);

  if (length(lastOutputSize - outputSize) > 0.00001)
  {
    lastOutputSize = outputSize;

    dV2 = {0.0,2.0/outputSize.y};
    dH2 = {2.0/outputSize.x,0.0};
    dV4 = {0.0,4.0/outputSize.y};
    dH4 = {4.0/outputSize.x,0.0};

  }
  setShaderUniform('verticalPass,'blurStep, dV2);
  setShaderUniform('horizontalPass,'blurStep, dH2);

  setShaderUniform('verticalPassB,'blurStep, dV4);
  setShaderUniform('horizontalPassB,'blurStep, dH4);

  f32 radius = mix(1.0, 2.9, intensity); # getParameterFloat('bloom_radius);
  f32 kernelSize = 40.0;
  f32 sigma = 50.0 * radius;

  if (abs(lastKernelSize - kernelSize) + abs(lastSigma - sigma) > 0.00001)
  {
    lastKernelSize = kernelSize;
    lastSigma = sigma;

    # sigma and kernelSize arrive in full-res pixels; divide both by the same
    # factor as the step so the Gaussian shape and extent are preserved while
    # the tap count drops to what the render target can actually resolve.
    # Kernels are kept odd sized (centre pixel + N pairs) to match the
    # two-at-a-time sampling in the shader.
    sigmaA = sigma / 2.0;
    kernelSizeA = 2.0*floor(kernelSize/4.0)+1.0;
    vec4 blockA = gaussianWeights(sigmaA, kernelSizeA);
    invTotalWeightA = blockA.x;
    forwardDifferencerA = {blockA.y, blockA.z, blockA.w};

    sigmaB = sigma / 4.0;
    kernelSizeB = 2.0*floor(kernelSize/8.0)+1.0;
    vec4 blockB = gaussianWeights(sigmaB, kernelSizeB);
    invTotalWeightB = blockB.x;
    forwardDifferencerB = {blockB.y, blockB.z, blockB.w};
  }

  setShaderUniform('verticalPass, 'invTotalWeight, invTotalWeightA);
  setShaderUniform('horizontalPass, 'invTotalWeight, invTotalWeightA);
  setShaderUniform('verticalPass, 'dda, forwardDifferencerA);
  setShaderUniform('horizontalPass, 'dda, forwardDifferencerA);
  setShaderUniform('verticalPass, 'sigma, sigmaA);
  setShaderUniform('verticalPass, 'kernelSize, kernelSizeA);
  setShaderUniform('horizontalPass, 'sigma, sigmaA);
  setShaderUniform('horizontalPass, 'kernelSize, kernelSizeA);


  setShaderUniform('verticalPassB, 'invTotalWeight, invTotalWeightB);
  setShaderUniform('horizontalPassB, 'invTotalWeight, invTotalWeightB);
  setShaderUniform('verticalPassB, 'dda, forwardDifferencerB);
  setShaderUniform('horizontalPassB, 'dda, forwardDifferencerB);
  setShaderUniform('verticalPassB, 'sigma, sigmaB);
  setShaderUniform('verticalPassB, 'kernelSize, kernelSizeB);
  setShaderUniform('horizontalPassB, 'sigma, sigmaB);
  setShaderUniform('horizontalPassB, 'kernelSize, kernelSizeB);

  setShaderUniform('threshold, 'threshold, 1.0 - amount);
  setShaderUniform('threshold, 'feather, 0.1);
  setShaderUniform('threshold, 'darken, 1.0);
}

string tritoneShader = "
  precision highp float;
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;

  uniform vec3 shadowColor;
  uniform vec3 midtoneColor;
  uniform vec3 highlightColor;
  // 'strength' is already declared by BaseUniformsOpenGL above.
  uniform float blendMode;

  // Blend mode functions
  vec3 blendMultiply(vec3 base, vec3 blend) {
    return base * blend;
  }

  vec3 blendScreen(vec3 base, vec3 blend) {
    return 1.0 - (1.0 - base) * (1.0 - blend);
  }

  vec3 blendOverlay(vec3 base, vec3 blend) {
    vec3 multiply = 2.0 * base * blend;
    vec3 screen = 1.0 - 2.0 * (1.0 - base) * (1.0 - blend);
    vec3 selector = step(vec3(0.5), base);
    return mix(multiply, screen, selector);
  }

  vec3 blendAdd(vec3 base, vec3 blend) {
    return min(base + blend, vec3(1.0));
  }

  void main() {
    vec2 uv = sourceTextureCoordinate;
    vec4 color = sampleInput(uv);

    // Convert to grayscale using luminance
    float luma = dot(color.rgb, vec3(0.299, 0.333, 0.368));

    // Map luminance to colors using smooth transitions
    // Shadow to midtone transition (0.0 - 0.5)
    // Midtone to highlight transition (0.5 - 1.0)
    vec3 colorized;

    if (luma < 0.5) {
        // Interpolate between shadow and midtone
        float t = luma * 2.0;
        colorized = mix(shadowColor, midtoneColor, t);
    } else {
        // Interpolate between midtone and highlight
        float t = (luma - 0.5) * 2.0;
        colorized = mix(midtoneColor, highlightColor, t);
    }

    // Apply blend mode
    vec3 blended;
    if (blendMode == 1.0) {
      blended = blendMultiply(color.rgb, colorized);
    } else if (blendMode == 2.0) {
      blended = blendScreen(color.rgb, colorized);
    } else if (blendMode == 3.0) {
      blended = blendOverlay(color.rgb, colorized);
    } else if (blendMode == 4.0) {
      blended = blendAdd(color.rgb, colorized);
    } else {
      // Default: Normal blend (just use colorized)
      blended = colorized;
    }

    // Blend with original based on strength
    vec3 result = mix(color.rgb, blended, strength);

    gl_FragColor = toOutputFormat(vec4(result, color.a));
  }
";


string thresholdGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform float threshold;
uniform float feather;
uniform float darken;

float luma(vec3 color) {
  return dot(color, vec3(0.3, 0.6, 0.1));
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 color = sampleInput(uv);

  float l = luma(color.xyz);

  color.rgb *= smoothstep(threshold - feather, threshold + feather , l);
  color.rgb *= darken;
  color.a = 1.0;

  gl_FragColor = toOutputFormat(color);
}
";

# double pass separables
string glslSeparableBlur = "
      precision highp float;

      varying vec2 textureCoordinate;
      varying vec2 sourceTextureCoordinate;
      BaseUniformsOpenGL;
      uniform float sigma;
      uniform float kernelSize;
      uniform vec2 blurStep;
      uniform float invTotalWeight;
      uniform vec3 dda;  // used to compute powers
      uniform sampler2D auxSampler1;

      void main() {

        vec2 uv = sourceTextureCoordinate;

        if (kernelSize <= 1.0) {
          gl_FragColor = toOutputFormat(sampleInput(uv));
          return;
        }

        vec4 color = sampleInput(uv);
        vec3 accumColor = color.rgb;

        float d0 = dda.x;
        float d1 = dda.y;
        float d2 = dda.z;

        for (float i = 1.0; i <= kernelSize; i = i + 2.0)
        {
            float s = 1.0 + d1;
            float a = d1 / s;
            vec2 step = (a + i) * blurStep;

            // sample 4 pixels via bilinear hardware
            accumColor += (s * d2) * (
              sampleInput(uv + step).rgb +
              sampleInput(uv - step).rgb
              );

            d2 = d2 * d1;
            d1 = d1 * d0;
            d2 = d2 * d1;
            d1 = d1 * d0;
        }

        gl_FragColor = toOutputFormat(vec4(accumColor * invTotalWeight,color.a));
      }";


# ==========================================================================
# Bloom compose - combines original image with blurred threshold output
# Multi-input: sampleInput = default (original), auxSampler1 = blur2
# ==========================================================================

string compositeGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform float bloomIntensity;
uniform float exposure;
uniform float saturation;
uniform vec3 bloomTintColor;
uniform vec3 tintColor;

uniform sampler2D auxSampler1;


vec3 adjustSaturation(vec3 rgb, float adjustment) {
  const vec3 W = vec3(0.2125, 0.7154, 0.0721);
  vec3 intensity = vec3(dot(rgb, W));
  return mix(intensity, rgb, adjustment);
}

void main() {

  vec4 color = sampleInput(sourceTextureCoordinate) * vec4(tintColor, 1.0);
  vec3 bloom = texture2D(auxSampler1, sourceTextureCoordinate).rgb * bloomTintColor * exposure;

  vec4 result = vec4(adjustSaturation(color.rgb, saturation) + bloom, 1.0);
  gl_FragColor = toOutputFormat( result );
}
";
