[Filter WebcamV2]

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        {lut_strength = 0.892, min = 0.0, max = 1.0, description = "LUT mix strength"},
        {lightness = 0.0, min = 0.0, max = 1.0, description = "Additive lightness boost"},
        {blur_strength = 9.269, min = 0.0, max = 50.0, description = "Directional blur strength"},
        {blur_dir_x = 0.467, min = -1.0, max = 1.0, description = "Blur direction X"},
        {blur_dir_y = 0.0, min = -1.0, max = 1.0, description = "Blur direction Y"},
    };

    filter.passes = {
        {
            name = 'graded,
            inputs = {'default, 'lut},
            uniforms = {
                lut_strength = 0.892,
                lightness = 0.0,
            },
            glslShader = lutShader,
        },
        {
            name = 'output,
            inputs = {'graded},
            uniforms = {
                blur_dir_x = 0.467,
                blur_dir_y = 0.0,
                blur_strength = 9.269,
                source_size_x = 1024.0,
            },
            glslShader = blurShader,
        },
    };
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('graded, 'lut_strength, s);

    f32 lt = getParameterFloat('lightness);
    setShaderUniform('graded, 'lightness, lt);

    vec2 srcSize = getTextureSize('default);
    if (srcSize.x > 0.0) {
        setShaderUniform('output, 'source_size_x, srcSize.x);
    }

    f32 bs = getParameterFloat('blur_strength);
    setShaderUniform('output, 'blur_strength, bs);

    f32 bdx = getParameterFloat('blur_dir_x);
    setShaderUniform('output, 'blur_dir_x, bdx);
    f32 bdy = getParameterFloat('blur_dir_y);
    setShaderUniform('output, 'blur_dir_y, bdy);
}

#### GLSL shaders ####

# Pass 1: 8x8 LUT color grade + additive lightness boost.
string lutShader = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float lut_strength;
    uniform float lightness;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);

      texel.rgb = clamp(texel.rgb, 0.00781, 0.98438);

      float x = texel.r / 8.0;
      float y = texel.g / 8.0;
      float z = texel.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      texel = mix(texel, vec4(color, texel.a), strength * lut_strength);

      texel.rgb = clamp(texel.rgb + lightness, 0.0, 1.0);

      gl_FragColor = toOutputFormat(texel);
    }
    ";

# Pass 2: 15-tap directional blur (Spark BlurDirectional model).
# stepUV = (blur_dir_x, blur_dir_y) * (blur_strength / source_width).
# Quartic (Power=4) weights, normalized so 15 taps sum to 1.0.
string blurShader = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float blur_dir_x;
    uniform float blur_dir_y;
    uniform float blur_strength;
    uniform float source_size_x;

    void main() {
      vec2 uv = sourceTextureCoordinate;

      vec2 stepUV = vec2(blur_dir_x, blur_dir_y) * (blur_strength / max(source_size_x, 1.0));

      vec4 center = sampleInput(uv);
      vec3 c = center.rgb * 0.30459;
      c += (sampleInput(uv + stepUV).rgb       + sampleInput(uv - stepUV).rgb)       * 0.17861;
      c += (sampleInput(uv + stepUV * 2.0).rgb + sampleInput(uv - stepUV * 2.0).rgb) * 0.09640;
      c += (sampleInput(uv + stepUV * 3.0).rgb + sampleInput(uv - stepUV * 3.0).rgb) * 0.04649;
      c += (sampleInput(uv + stepUV * 4.0).rgb + sampleInput(uv - stepUV * 4.0).rgb) * 0.01904;
      c += (sampleInput(uv + stepUV * 5.0).rgb + sampleInput(uv - stepUV * 5.0).rgb) * 0.00603;
      c += (sampleInput(uv + stepUV * 6.0).rgb + sampleInput(uv - stepUV * 6.0).rgb) * 0.00119;
      c += (sampleInput(uv + stepUV * 7.0).rgb + sampleInput(uv - stepUV * 7.0).rgb) * 0.00007;

      gl_FragColor = toOutputFormat(vec4(c, center.a));
    }
    ";
