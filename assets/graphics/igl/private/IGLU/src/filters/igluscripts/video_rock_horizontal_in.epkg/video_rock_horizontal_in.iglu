[Filter IgluscriptVideoRockHorizontalInFilter]
[MaskBehavior alpha]

# AE source: POSITION_ROCK_LEFT_IN (all 4 directions share identical curves)

fun mix(f32 a, f32 b, f32 t) f32 {
  return a * (1.0 - t) + b * t;
}

fun cssBezier(f32 time, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 t = time;
  f32 i = 0.0;
  while (i < 8.0) {
    f32 u = 1.0 - t;
    f32 xt = 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t;
    f32 dxdt = 3.0 * u * u * x1 + 6.0 * u * t * (x2 - x1) + 3.0 * t * t * (1.0 - x2);
    t = t - (xt - time) / max(dxdt, 0.0001);
    t = clamp(t, 0.0, 1.0);
    i = i + 1.0;
  }
  f32 u = 1.0 - t;
  return 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t;
}

# Position displacement keyframe times (normalized, within 0-0.9375 of full duration)
f32 PT0 = 0.0;
f32 PT1 = 0.3125;
f32 PT2 = 0.65625;
f32 PT3 = 0.9375;

# Position displacement values (pixel deltas from rest, AE 720px comp)
f32 PK0 = 1041.0;
f32 PK1 = -136.7;
f32 PK2 = 36.7;
f32 PK3 = 0.0;

# Rotation keyframe times (normalized, full duration)
f32 RT0 = 0.0;
f32 RT1 = 0.375;
f32 RT2 = 0.71875;
f32 RT3 = 1.0;

# Rotation values (radians, from AE degrees)
f32 RK0 = 0.5411;
f32 RK1 = 0.8378;
f32 RK2 = -0.2269;
f32 RK3 = 0.0;

fun evalPos(f32 p) f32 {
  f32 pos = PK3;
  f32 f = 0.0;
  f32 t = 0.0;

  if (p < PT1) {
    f = p / PT1;
    t = cssBezier(f, 0.1667, 0.1667, 0.1848, 1.0);
    pos = mix(PK0, PK1, t);
  } else if (p < PT2) {
    f = (p - PT1) / (PT2 - PT1);
    t = cssBezier(f, 0.7505, 0.0, 0.6667, 0.492);
    pos = mix(PK1, PK2, t);
  } else if (p < PT3) {
    f = (p - PT2) / (PT3 - PT2);
    t = cssBezier(f, 0.3333, -1.9624, 0.6667, 1.0);
    pos = mix(PK2, PK3, t);
  }

  return pos;
}

fun evalRotation(f32 p) f32 {
  f32 rot = RK3;
  f32 f = 0.0;
  f32 t = 0.0;

  if (p < RT1) {
    f = p / RT1;
    t = cssBezier(f, 0.1671, 0.0426, 0.2078, 1.0);
    rot = mix(RK0, RK1, t);
  } else if (p < RT2) {
    f = (p - RT1) / (RT2 - RT1);
    t = cssBezier(f, 0.7505, 0.0, 0.6667, 1.0);
    rot = mix(RK1, RK2, t);
  } else if (p < RT3) {
    f = (p - RT2) / (RT3 - RT2);
    t = cssBezier(f, 0.3333, 0.0, 0.6667, 1.0);
    rot = mix(RK2, RK3, t);
  }

  return rot;
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {direction = 0.0, min = 0.0, max = 1.0, description = "0 = Right-to-center, 1 = Left-to-center"},
    {outro = 0.0, min = 0.0, max = 1.0, description = "0 = In, 1 = Out"},
  };

  filter.passes = {
    {
      name = 'rockFx,
      inputs = {'default},
      uniforms = {
        position = {0.0, 0.0},
        rotation = 0.0,
        opacity = 1.0,
        aspect = 1.0,
      },
      glslShader = glsl,
    },
    {
      name = 'dirBlur,
      inputs = {'rockFx},
      uniforms = {
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = blurGlsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  f32 outro = getParameterFloat('outro);
  f32 dir = getParameterFloat('direction);

  f32 ep = p;
  if (outro > 0.5) {
    ep = 1.0 - p;
  }

  # Direction code (Component.kt): left = 0, right = 1, so 0.5 separates them.
  f32 sign = 1.0;
  if (outro < 0.5) {
    if (dir < 0.5) { sign = 0.0 - 1.0; }
  } else {
    if (dir > 0.5) { sign = 0.0 - 1.0; }
  }

  f32 blurScale = 15.0;

  vec2 size = getTextureSize('default);
  f32 texW = size.x;
  f32 aspect = size.x / size.y;

  f32 posVal = evalPos(ep);
  f32 posValPrev = evalPos(max(ep - 0.008, 0.0));
  f32 rotation = evalRotation(ep);

  # Travel is expressed in frame widths, NOT pixels/texW. Dividing the AE pixel
  # keyframes by the runtime texture width made the travel depend on resolution and
  # orientation: a 1920-wide landscape clip only travelled 1.08 frame widths, so the
  # rotated corners peeked back into frame.
  #
  # A frame rotated by `rot` spans (|cos| + |sin|/aspect) frame widths along x, so it
  # is fully clear once translated by 0.5 + that/2. Evaluate at RK0, the rotation at
  # the p=0 peak-displacement keyframe. sqrt(2) is the floor (covers 16:9 and 9:16);
  # taller portraits such as 9:19.5 need more, so take whichever is larger.
  f32 SQRT2 = 1.4142136;
  f32 c0 = abs(cos(RK0));
  f32 s0 = abs(sin(RK0));
  f32 clearance = 0.5 + (c0 + s0 / max(aspect, 0.0001)) * 0.5;
  f32 travel = max(SQRT2, clearance);

  # PK0 is the p=0 entry displacement, so posVal / PK0 normalizes the curve to
  # 1.0 at full extension and carries the rock-back overshoots proportionally.
  f32 offsetUV = posVal / PK0 * travel;
  f32 offset = sign * offsetUV;

  f32 velocity = abs(posVal - posValPrev) / PK0 * travel;
  f32 blurAmount = velocity * blurScale;

  f32 texelSize = 1.0 / texW;
  f32 ghostSpread = blurAmount * 10.0 * texelSize;
  vec2 ghostDir = {sign, 0.0};

  f32 opacity = 1.0;
  rotation = sign*rotation*-1.0;
  if (outro < 0.5) {
    opacity = clamp(p / 0.06, 0.0, 1.0);
  } else {
    opacity = clamp((1.0 - p) / 0.06, 0.0, 1.0);
    rotation = rotation * -1.0;
  }
  vec2 pos = {-offset, 0.0};
  setShaderUniform('rockFx, 'position, pos);
  setShaderUniform('rockFx, 'rotation, rotation);
  setShaderUniform('rockFx, 'opacity, opacity);
  setShaderUniform('rockFx, 'aspect, aspect);
  setShaderUniform('dirBlur, 'ghostSpread, ghostSpread);
  setShaderUniform('dirBlur, 'ghostDir, ghostDir);
}

string blurGlsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float ghostSpread;
uniform vec2 ghostDir;

float clipAlpha(vec2 uv) {
  float e = 0.005;
  return smoothstep(0.0, e, uv.x) * smoothstep(0.0, e, 1.0 - uv.x)
       * smoothstep(0.0, e, uv.y) * smoothstep(0.0, e, 1.0 - uv.y);
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  // Weighting each ghost by clipAlpha drops samples that land outside the frame
  // instead of letting them wrap to the opposite edge, and renormalizing by
  // totalWeight keeps the edge from darkening.
  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 gUV = uv + ghostDir * ghostSpread * fi;
    float k = 2.0;
    float weight = (1.0 / (1.0 + k * abs(fi))) * clipAlpha(gUV);
    color += sampleInput(gUV) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(color / max(totalWeight, 0.001));
}
";

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform vec2 position;
uniform float rotation;
uniform float opacity;
uniform float aspect;
uniform vec2 inputSize;

// One-pixel antialiased frame edge. The +0.5 bias puts the ramp entirely outside the
// first interior pixel, so an untransformed frame stays fully opaque. A fixed uv
// epsilon instead fades a fraction of the frame regardless of resolution, which shows
// up as a permanent margin once the animation settles.
float clipAlpha(vec2 uv) {
  vec2 texel = 1.0 / max(inputSize, vec2(1.0));
  vec2 d = min(uv, 1.0 - uv);
  vec2 a = clamp(d / texel + 0.5, 0.0, 1.0);
  return a.x * a.y;
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec2 center = vec2(0.5);

  // DOWN (-1.0 on OpenGL, +1.0 on Metal) compensates for OpenGL's bottom-left
  // texture origin, which mirrors both a vertical offset and the sense of a
  // rotation relative to the iOS/Metal path.
  uv.x -= position.x;
  uv.y -= DOWN * position.y;

  uv -= center;
  uv.x *= aspect;
  float rot = DOWN * rotation;
  float cosR = cos(rot);
  float sinR = sin(rot);
  vec2 rotated = vec2(
    uv.x * cosR - uv.y * sinR,
    uv.x * sinR + uv.y * cosR
  );
  uv = rotated;
  uv.x /= aspect;
  uv += center;

  float ca = clipAlpha(uv);
  vec4 color = sampleInput(uv) * ca * opacity;
  gl_FragColor = toOutputFormat(color);
}
";
