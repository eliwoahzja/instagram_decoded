[Filter VideoBulge2]
# Pulsing radial bulge distortion driven by an animation texture.
# Ported from GLSL text animation: "Bulge"
#
# Carries both behaviors, selected in [PreRender] rather than in the shaders:
#   useBeats false -> clock-driven, time_sec x speed, looping, phase 0
#   useBeats true  -> beat-driven, animation position comes from `phase` alone
#
# `phase` is additive on the clock term and defaults to 0, so the clock path is
# unchanged. useBeats is set by BeatReactiveController when a manifest declares
# beatReactive; with no such manifest nothing writes it and the false default
# selects the clock.

[Init]
fun init(Filter filter) {
    loadTexture('animation, 'texture://TextBulgeAssets/Bulge);

    filter.parameters = {
        {speed = 0.0, min = 0.0, max = 1.0, description = "Animation speed"},
        {size = 0.0, min = 0.0, max = 1.0},
        {beatProgress = 0.0, min = 0.0, max = 1.0, description = "Beat-driven animation position"},
        {beatAmplitude = 0.0, min = 0.0, max = 1.0, description = "Beat hierarchy strength, held for the whole beat"},
        {useBeats = false, description = "True while the beat system is driving this effect"},
    };

    filter.passes = {{
        name = 'pass0,
        inputs = {'default, 'animation},
        uniforms = {
            speed = 0.39,
            loop = 1.0,
            phase = 0.0,
            bulgeChannel = 0.5,
            bulgeMin = -1.0,
            bulgeMax = 0.1613,
            bulgeRadius = 0.59,
            bulgeCurvature = 0.45,
            bulgeIntensity = 0.7,
        },
        glslShader = glslPass0,
        metalShader = metalPass0,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    boolean useBeats = getParameterBoolean('useBeats);

    f32 speed = getParameterFloat('speed);
    f32 animationSpeed = 0.39 + speed * (1.5 - 0.39);
    f32 loopMode = 1.0;
    f32 phase = 0.0;
    f32 baseIntensity = 0.7;
    f32 intensity = baseIntensity;

    if (useBeats) {
        # The animation texture holds one complete gesture and `phase` is the read position
        # into it, so the beat drives position and magnitude separately.
        #
        # `beatAmplitude` holds this beat's hierarchy strength for the whole beat;
        # `beatProgress` is that strength times the envelope. Dividing recovers the unscaled
        # envelope, making the read position identical for every beat type.
        #
        # Magnitude applies after the read, via bulgeIntensity. Rest maps to 0.0 bulge, so
        # scaling leaves rest at rest and scales only the excursions.
        #
        # `beatAmplitude` is a pulse whose width exceeds any real beat interval, so it holds
        # strength for the whole beat. The ratio is exact only while both parameters resolve to
        # the same beat, which holds when attack is 0 -- the envelope indexes on a
        # pre-roll-shifted time and the pulse does not. The clamp keeps the read position in
        # range if that ever stops being true.
        f32 beatProgress = getParameterFloat('beatProgress);
        f32 amplitude = getParameterFloat('beatAmplitude);
        f32 envelope = 0.0;
        if (amplitude > 0.0) {
            envelope = clamp(beatProgress / amplitude, 0.0, 1.0);
        }
        animationSpeed = 0.0;
        loopMode = 0.0;
        phase = 1.0 - envelope;
        intensity = baseIntensity * amplitude;
    }

    setShaderUniform('pass0, 'speed, animationSpeed);
    setShaderUniform('pass0, 'loop, loopMode);
    setShaderUniform('pass0, 'phase, phase);
    setShaderUniform('pass0, 'bulgeIntensity, intensity);

    f32 size = getParameterFloat('size);
    f32 bulgeRadius = 0.59 + size * (2.0 - 0.59);
    setShaderUniform('pass0, 'bulgeRadius, bulgeRadius);
}

string glslPass0 = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform float time_sec;

    uniform float speed;
    uniform float loop;
    uniform float phase;
    uniform float bulgeChannel;
    uniform float bulgeMin;
    uniform float bulgeMax;
    uniform float bulgeRadius;
    uniform float bulgeCurvature;
    uniform float bulgeIntensity;

    uniform sampler2D auxSampler1;

    float byteCombine(vec2 v) {
        float highByte = v.r * 255.0;
        float lowByte = v.g * 255.0;
        float scaled = highByte * 256.0 + lowByte;
        float normalized = scaled / 65535.0;
        return normalized;
    }

    float mapRange(float x, float lowIn, float highIn, float lowOut, float highOut) {
        if (highIn == lowIn)
            return highIn;
        float w = highIn - lowIn;
        x = x - lowIn;
        x /= w;
        float ow = highOut - lowOut;
        x *= ow;
        x += lowOut;
        return x;
    }

    float mapValue(float x, float lowOut, float highOut) {
        return mapRange(x, 0.0, 1.0, lowOut, highOut);
    }

    vec4 sampleAnimation(sampler2D tex, float t, float channel) {
        return texture2D(tex, vec2(t, channel));
    }

    vec2 bulge_uvs(vec2 uv, float radius, float bstrength, float power) {
        float dist = length(uv);
        float effect = max(0.0, 1.0 - (dist / radius));
        float bulge = 1.0 + bstrength * pow(effect, power);
        return uv * bulge;
    }

    float mirror(float x) {
        return 1.0 - abs(mod(x + 2.0, 2.0) - 1.0);
    }

    vec2 mirrorUV(vec2 uv) {
        return vec2(mirror(uv.x), mirror(uv.y));
    }

    void main() {
        float t = time_sec * speed + phase;
        float lt = fract(t);
        t = mix(t, lt, loop);

        vec4 bulge_sample = sampleAnimation(auxSampler1, t, bulgeChannel);
        float bulge = byteCombine(bulge_sample.rg);
        bulge = mapValue(bulge, bulgeMin, bulgeMax);

        vec2 uv = sourceTextureCoordinate;
        uv -= 0.5;
        vec2 buvs = bulge_uvs(uv, bulgeRadius, bulge * bulgeIntensity, bulgeCurvature);
        float mixer = smoothstep(0.4, bulgeRadius, length(uv));
        uv = mix(buvs, uv, mixer);
        uv += 0.5;

        uv = mirrorUV(uv);
        vec4 color = sampleInput(uv);
        gl_FragColor = toOutputFormat(color);
    }
";

string metalPass0 = "
    using namespace metal;

    struct fragmentOut { float4 _gl_FragColor [[color(0)]]; };
    struct fragmentIn { float2 sourceTextureCoordinate [[user(locn1)]]; };

    typedef struct {
        float4x4 content_transform;
        float4x4 texture_transform;
        float time_sec;
        float speed;
        float loop;
        float phase;
        float bulgeChannel;
        float bulgeMin;
        float bulgeMax;
        float bulgeRadius;
        float bulgeCurvature;
        float bulgeIntensity;
    } Uniforms;

    float byteCombine(float2 v) {
        float highByte = v.r * 255.0;
        float lowByte = v.g * 255.0;
        float scaled = highByte * 256.0 + lowByte;
        float normalized = scaled / 65535.0;
        return normalized;
    }

    float mapRange(float x, float lowIn, float highIn, float lowOut, float highOut) {
        if (highIn == lowIn)
            return highIn;
        float w = highIn - lowIn;
        x = x - lowIn;
        x /= w;
        float ow = highOut - lowOut;
        x *= ow;
        x += lowOut;
        return x;
    }

    float mapValue(float x, float lowOut, float highOut) {
        return mapRange(x, 0.0, 1.0, lowOut, highOut);
    }

    float4 sampleAnimationTex(texture2d<float> tex, sampler texSmplr, float t, float channel) {
        return tex.sample(texSmplr, float2(t, channel));
    }

    float2 bulge_uvs(float2 uv, float radius, float bstrength, float power) {
        float dist = length(uv);
        float effect = max(0.0f, 1.0f - (dist / radius));
        float bulge = 1.0f + bstrength * pow(effect, power);
        return uv * bulge;
    }

    float mirror(float x) {
        return 1.0 - abs(fmod(x + 2.0, 2.0) - 1.0);
    }

    float2 mirrorUV(float2 uv) {
        return float2(mirror(uv.x), mirror(uv.y));
    }

    fragment fragmentOut fragmentShader(fragmentIn in [[stage_in]],
                                        constant Uniforms & uniforms [[buffer(1)]],
                                        DefaultInputs defaultInputs,
                                        texture2d<float> tex1,
                                        sampler tex1Smplr) {
        float t = uniforms.time_sec * uniforms.speed + uniforms.phase;
        float lt = fract(t);
        t = mix(t, lt, uniforms.loop);

        float4 bulge_sample = sampleAnimationTex(tex1, tex1Smplr, t, uniforms.bulgeChannel);
        float bulge = byteCombine(bulge_sample.rg);
        bulge = mapValue(bulge, uniforms.bulgeMin, uniforms.bulgeMax);

        float2 uv = in.sourceTextureCoordinate;
        uv -= 0.5;
        float2 buvs = bulge_uvs(uv, uniforms.bulgeRadius, bulge * uniforms.bulgeIntensity, uniforms.bulgeCurvature);
        float mixer = smoothstep(0.4f, uniforms.bulgeRadius, length(uv));
        uv = mix(buvs, uv, mixer);
        uv += 0.5;

        uv = mirrorUV(uv);
        float4 color = sampleInput(defaultInputs, uv);
        fragmentOut out = {};
        out._gl_FragColor = toOutputFormat(color);
        return out;
    }
";
