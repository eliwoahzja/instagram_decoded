[Filter ProductWash]
[MaskBehavior composite]

[Init]
fun init(Filter filter) {
  # Declares the named mask input that the host binds to the object silhouette.
  makeTexture('mask);

  filter.parameters = {
    {speed = 0.5, min = 0.0, max = 4.0, description = "Wash Speed"},
    {waveCount = 2.0, min = 0.5, max = 8.0, description = "Wave Count"},
    {opacity = 0.9, min = 0.0, max = 1.0, description = "Wash Opacity"},
    {type = 0.0, min = 0.0, max = 1.0, description = "Type (sine to gradient)"},
    {washColor = {1.0, 1.0, 1.0, 1.0}, description = "Wash Color"},
  };

  filter.passes = {
    {
      name = 'center,
      inputs = {'mask},
      scale = {0.01, 0.01},
      uniforms = {
        aspect = 0.5625,
      },
      glslShader = centerGlsl,
    },
    {
      name = 'compose,
      inputs = {'default, 'mask, 'center},
      uniforms = {
        outputSize = {1080.0, 1920.0},
        phase = 0.0,
        waveCount = 2.0,
        opacity = 0.6,
        type = 0.0,
        washColor = {1.0, 1.0, 1.0, 1.0},
      },
      glslShader = composeGlsl,
    }
  };
}

[PreRender]
fun preRender(Filter filter) {
  vec2 size = getTextureSize('default);

  setShaderUniform('center, 'aspect, size.x / size.y);

  f32 phase = getParameterFloat('time_sec) * getParameterFloat('speed);

  setShaderUniform('compose, 'outputSize, size);
  setShaderUniform('compose, 'phase, phase);
  setShaderUniform('compose, 'waveCount, getParameterFloat('waveCount));
  setShaderUniform('compose, 'opacity, getParameterFloat('opacity));
  setShaderUniform('compose, 'type, getParameterFloat('type));
  setShaderUniform('compose, 'washColor, getParameterVec4('washColor));
}

string centerGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform float aspect;

#define GRID_SIZE 32
#define RADIUS_SCALE 4.0

float maskCoverage(vec4 c) {
  return max(c.r, max(c.g, c.b));
}

void main() {
  float gridStep = 1.0 / float(GRID_SIZE);

  vec2 weighted = vec2(0.0);
  float total = 0.0;

  for (int y = 0; y < GRID_SIZE; y++) {
    for (int x = 0; x < GRID_SIZE; x++) {
      vec2 sampleUV = (vec2(float(x), float(y)) + 0.5) * gridStep;
      float coverage = maskCoverage(sampleInput(sampleUV));
      weighted += sampleUV * coverage;
      total += coverage;
    }
  }

  vec2 maskCenter = total > 0.0001 ? weighted / total : vec2(0.5);

  float extent = 0.0;
  for (int y = 0; y < GRID_SIZE; y++) {
    for (int x = 0; x < GRID_SIZE; x++) {
      vec2 sampleUV = (vec2(float(x), float(y)) + 0.5) * gridStep;
      if (maskCoverage(sampleInput(sampleUV)) > 0.5) {
        vec2 delta = sampleUV - maskCenter;
        delta.x *= aspect;
        extent = max(extent, length(delta));
      }
    }
  }
  extent = max(extent, 0.05);

  gl_FragColor = toOutputFormat(vec4(maskCenter, extent / RADIUS_SCALE, 1.0));
}
";

string composeGlsl = "
precision highp float;

varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform sampler2D auxSampler1;
uniform sampler2D auxSampler2;

uniform vec2 outputSize;
uniform float phase;
uniform float waveCount;
uniform float opacity;
uniform float type;
uniform vec4 washColor;

#define TWO_PI 6.2831853
#define RADIUS_SCALE 4.0
#define GRADIENT_SMOOTH 0.15

float maskCoverage(vec4 c) {
  return max(c.r, max(c.g, c.b));
}

void main() {
  vec2 uv = sourceTextureCoordinate;

  vec4 base = sampleInput(uv);
  float subject = maskCoverage(texture2D(auxSampler1, uv));

  float travel = uv.y * waveCount + phase;
  float sineWave = 0.5 + 0.5 * sin(travel * TWO_PI);

  float f = 1.0 - fract(travel);
  float gradientWave = clamp(
      f * smoothstep(0.0, GRADIENT_SMOOTH, 1.0 - f) / (1.0 - GRADIENT_SMOOTH),
      0.0, 1.0);

  float wave = mix(sineWave, gradientWave, type);

  vec4 centerData = texture2D(auxSampler2, vec2(0.5));
  vec2 center = centerData.xy;
  float extent = max(centerData.z * RADIUS_SCALE, 0.001);

  vec2 delta = uv - center;
  delta.x *= outputSize.x / outputSize.y;

  float dist = clamp(length(delta) / extent, 0.0, 1.0);

  float radial = smoothstep(1.0, 0.0, dist);

  float alpha = wave * radial * subject * opacity * washColor.a;

  vec3 color = mix(base.rgb, washColor.rgb, alpha);
  gl_FragColor = toOutputFormat(vec4(color, base.a));
}
";
