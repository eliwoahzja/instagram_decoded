[Filter SlideHorizontalOut]
[MaskBehavior alpha]

# OUT wrapper — composes slide_horizontal_in with outro=1.0

[Init]
fun init(Filter filter) {
  filter.passes = {{
      name = 'slideHOut,
      igid = 'video_slide_horizontal_in,
      inputs = {'default},
      uniforms = {},
    }};

  filter.parameters = {
    {direction = 0.0, min = 0.0, max = 1.0, description = "0 = Center-to-left, 1 = Center-to-right"},
    {positionScale = 2.0, min = 0.0, max = 5.0, description = "Scale position offset"},
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 dir = getParameterFloat('direction);
  f32 invertedDir = 1.0 - dir;
  setShaderUniform('slideHOut, 'progress, getParameterFloat('progress));
  setShaderUniform('slideHOut, 'direction, invertedDir);
  setShaderUniform('slideHOut, 'scale, 1.0);
  setShaderUniform('slideHOut, 'outro, 1.0);
}
