[Filter TextBulge]
#
# Port of C++ text_bulge/TextBulgeFilter.cpp — continuous looping radial bulge driven by a baked
# animation curve (Bulge LUT, TextBulgeAssets/Bulge). LOOP family: shader `time` is driven from the
# host `renderFrameTimeSeconds` param (the continuous value the C++ filter reads on Android), NOT
# `time_sec`. Shaderc-safe: overloaded map() split into map()/mapSimple(). No behavior header
# (Static). Metal auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {renderFrameTimeSeconds = 0.0, description = "Continuous media time (seconds), host-driven"},
        {speed = 0.39},
        {loop = 1.0},
        {bulge_Channel = 0.5},
        {bulgeMin = -1.0},
        {bulgeMax = 0.16},
        {phase = 0.0},
        {bulgeRadius = 0.59},
        {bulgeCurvature = 0.45},
        {bulgeIntensity = 0.7},
    };

    loadTexture('animation, 'texture://TextBulgeAssets/Bulge);

    filter.passes = {{
        name = 'bulge,
        inputs = {'default, 'animation},
        uniforms = {
            outputSize = {100.0, 100.0},
            time = 0.0,
            speed = 0.39,
            loop = 1.0,
            bulge_Channel = 0.5,
            bulgeMin = -1.0,
            bulgeMax = 0.16,
            phase = 0.0,
            bulgeRadius = 0.59,
            bulgeCurvature = 0.45,
            bulgeIntensity = 0.7,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    vec2 defaultSize = getTextureSize('default);
    setShaderUniform('bulge, 'outputSize, defaultSize);
    setShaderUniform('bulge, 'time, getParameterFloat('renderFrameTimeSeconds));
    setShaderUniform('bulge, 'speed, getParameterFloat('speed));
    setShaderUniform('bulge, 'loop, getParameterFloat('loop));
    setShaderUniform('bulge, 'bulge_Channel, getParameterFloat('bulge_Channel));
    setShaderUniform('bulge, 'bulgeMin, getParameterFloat('bulgeMin));
    setShaderUniform('bulge, 'bulgeMax, getParameterFloat('bulgeMax));
    setShaderUniform('bulge, 'phase, getParameterFloat('phase));
    setShaderUniform('bulge, 'bulgeRadius, getParameterFloat('bulgeRadius));
    setShaderUniform('bulge, 'bulgeCurvature, getParameterFloat('bulgeCurvature));
    setShaderUniform('bulge, 'bulgeIntensity, getParameterFloat('bulgeIntensity));
}


# --- GLSL Shader (faithful port of TextBulgeFilter.cpp bulgeFragmentShaderStr) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform vec2 outputSize;
    uniform float time;
    uniform float speed;
    uniform float loop;
    uniform float bulge_Channel;
    uniform float bulgeMin;
    uniform float bulgeMax;
    uniform float phase;
    uniform float bulgeRadius;
    uniform float bulgeCurvature;
    uniform float bulgeIntensity;
    uniform sampler2D auxSampler1;

    vec4 sampleAnimation(sampler2D tex, float t, float channel) {
        vec2 uv1 = vec2(t, channel);
        vec4 samp1 = texture2D(tex, uv1);
        return samp1;
    }

    float map(float x, float lowIn, float highIn, float lowOut, float highOut) {
        if (highIn == lowIn) {
            return highIn;
        }
        float w = highIn - lowIn;
        x = x - lowIn;
        x /= w;
        float ow = highOut - lowOut;
        x *= ow;
        x += lowOut;
        return x;
    }

    float mapSimple(float x, float lowOut, float highOut) {
        return map(x, 0.0, 1.0, lowOut, highOut);
    }

    float byteCombine(vec2 v) {
        float highByte = v.r * 255.0;
        float lowByte = v.g * 255.0;
        float scaled = highByte * 256.0 + lowByte;
        float normalized = scaled / 65535.0;
        return normalized;
    }

    vec2 bulge_uvs(vec2 uv, float radius, float strength, float power) {
        float dist = length(uv);
        float effect = max(0.0, 1.0 - (dist / radius));
        float bulge = 1.0 + strength * pow(effect, power);
        return uv * bulge;
    }

    void main() {
        float t = time * speed;
        t += phase;
        float lt = fract(t);
        t = mix(t, lt, loop);

        vec4 bulge_sample = sampleAnimation(auxSampler1, t, bulge_Channel);
        float bulge = byteCombine(bulge_sample.rg);
        bulge = mapSimple(bulge, bulgeMin, bulgeMax);

        vec2 aspect = vec2(1.0, outputSize.x / outputSize.y);
        vec2 uv = sourceTextureCoordinate;

        uv -= 0.5;
        vec2 buvs = bulge_uvs(uv, bulgeRadius, bulge * bulgeIntensity, bulgeCurvature);
        float mixer = smoothstep(0.4, bulgeRadius, length(uv));
        uv = mix(buvs, uv, mixer);
        uv += 0.5;

        vec4 color = sampleInput(uv);
        gl_FragColor = toOutputFormat(color);
    }
";
