[Filter TextBlurIn]
#
# Port of C++ text_blur_in/TextBlurInFilter.cpp — a 5-pass intro blur-fade: two downsampling box
# blurs (0.5, 0.25), then separable animated gaussian H/V (0.25), then a composite that crossfades
# the sharp glyphs in and fades opacity up as progress runs 0 -> 1. The gaussian kernel count is
# numSamples = 18 * sizeScale * smoothstep(1 - progress) (sizeScale = max(w,h)/1080), computed in
# [PreRender] exactly as the C++ updateUniforms does. The C++ gaussian's runtime-count loop is
# expressed shaderc-safely as a constant-bound (120) loop with an `i >= kernelSize` break (the
# proven video_cutout_blur pattern), so it unrolls on iOS Metal too. Faithful to the C++ TEXT
# shaders; Metal auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {progress = 0.0},
    };

    filter.passes = {
        {
            name = 'boxblur_0,
            inputs = {'default},
            scale = {0.5, 0.5},
            uniforms = {output_size = {100.0, 100.0}},
            glslShader = boxGlsl,
        },
        {
            name = 'boxblur_1,
            inputs = {'boxblur_0},
            scale = {0.25, 0.25},
            uniforms = {output_size = {100.0, 100.0}},
            glslShader = boxGlsl,
        },
        {
            name = 'blurH,
            inputs = {'boxblur_1},
            scale = {0.25, 0.25},
            uniforms = {
                blurStep = 1.0,
                numSamples = 0.0,
                falloffCurve = 15.0,
                axis = {1.0, 0.0},
                outputSize = {100.0, 100.0},
            },
            glslShader = gaussGlsl,
        },
        {
            name = 'blurV,
            inputs = {'blurH},
            scale = {0.25, 0.25},
            uniforms = {
                blurStep = 1.0,
                numSamples = 0.0,
                falloffCurve = 15.0,
                axis = {0.0, 1.0},
                outputSize = {100.0, 100.0},
            },
            glslShader = gaussGlsl,
        },
        {
            name = 'blur_composite,
            inputs = {'default, 'blurV},
            uniforms = {progress = 0.0},
            glslShader = composeGlsl,
        },
    };
}

[PreRender]
fun preRender(Filter filter) {
    vec2 full = getTextureSize('default);
    vec2 half = full * 0.5;
    vec2 quarter = full * 0.25;

    setShaderUniform('boxblur_0, 'output_size, full);
    setShaderUniform('boxblur_1, 'output_size, half);

    f32 progress = getParameterFloat('progress);
    f32 sizeScale = max(full.x, full.y) / 1080.0;
    # smoothstep(0, 1, 1 - progress); progress is already in [0,1]
    f32 sp = 1.0 - progress;
    f32 numSamples = 18.0 * sizeScale * (sp * sp * (3.0 - 2.0 * sp));

    setShaderUniform('blurH, 'numSamples, numSamples);
    setShaderUniform('blurH, 'outputSize, quarter);
    setShaderUniform('blurV, 'numSamples, numSamples);
    setShaderUniform('blurV, 'outputSize, quarter);

    setShaderUniform('blur_composite, 'progress, progress);
}


# --- Box blur (faithful port of BoxBlurShader.cpp boxBlurFragmentShaderStr) ---
string boxGlsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform vec2 output_size;

    vec4 boxFilter(vec2 uv, vec2 duv) {
        vec4 color;
        color = sampleInput(uv + vec2(-duv.x, -duv.y));
        color += sampleInput(uv + vec2(duv.x, -duv.y));
        color += sampleInput(uv + vec2(-duv.x, duv.y));
        color += sampleInput(uv + vec2(duv.x, duv.y));
        return 0.25 * color;
    }

    void main() {
        if (output_size.x == 0.0 || output_size.y == 0.0) {
            gl_FragColor = toOutputFormat(sampleInput(sourceTextureCoordinate));
            return;
        }
        gl_FragColor = toOutputFormat(boxFilter(sourceTextureCoordinate, 1.0 / output_size));
    }
";


# --- Animated gaussian (faithful port of GaussianBlurAnimatedShader.cpp; progress_enabled = false
# so t = 1.0; runtime kernel via constant-bound loop + break for shaderc safety) ---
string gaussGlsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform float blurStep;
    uniform float numSamples;
    uniform float falloffCurve;
    uniform vec2 axis;
    uniform vec2 outputSize;

    float gauss(float x, float e) { return exp(-(x * x) / e); }

    void main() {
        vec2 uv = sourceTextureCoordinate;
        float kernelSizef = numSamples;
        int kernelSize = int(kernelSizef);
        float halfKernel = -0.5 * float(kernelSize - 1);

        if (kernelSize <= 1) {
            gl_FragColor = toOutputFormat(sampleInput(uv));
            return;
        }

        float falloff = falloffCurve * kernelSizef * 0.5;
        float accumWeight = 0.0;
        vec4 accumColor = vec4(0.0);
        vec2 offset = axis * blurStep / outputSize;

        for (int i = 0; i < 120; i++) {
            if (i >= kernelSize) break;
            float x = halfKernel + float(i);
            float weight = gauss(x, falloff);
            vec4 tex = sampleInput(uv + x * offset);
            accumColor += weight * tex;
            accumWeight += weight;
        }
        accumColor /= accumWeight;
        gl_FragColor = toOutputFormat(accumColor);
    }
";


# --- Composite (faithful port of TextBlurInFilter.cpp blurFadeComposeGL; 'blurV -> auxSampler1) ---
string composeGlsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;
    uniform float progress;
    uniform sampler2D auxSampler1;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec4 base = sampleInput(uv);
        vec4 blur = texture2D(auxSampler1, uv);

        float t = smoothstep(0.0, 1.0, 1.0 - progress);
        vec4 color = mix(base, blur, smoothstep(0.0, 0.05, t));

        color *= progress;

        gl_FragColor = toOutputFormat(color);
    }
";
