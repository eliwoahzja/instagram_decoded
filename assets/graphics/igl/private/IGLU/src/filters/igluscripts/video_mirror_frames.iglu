[Filter IgluscriptVideoMirrorFramesFilter]

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {duration = 0.5, min = 0.25, max = 2.0, description = "Effect duration"},
    {amount = 3.0, min = 2.0, max = 10.0, description = "Number of layers"},
  };
  filter.passes = {{
      name = 'mirror_frames, inputs = {'default},
      uniforms = {
        progress = 0.0,
        inputSize = {1080.0, 1920.0},
      },
      glslShader = glsl
    }};
}

[PreRender]
fun preRender(Filter filter) {
  f32 layers = getParameterFloat('amount);
  setShaderUniform('mirror_frames, 'layers, layers);
}

string glsl = "

varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform vec2 inputSize;
uniform float progress;
uniform float layers;

const vec2 center = vec2(0.5, 0.5);

void main() {

  vec2 uv = sourceTextureCoordinate;
  vec4 color = vec4(0.0);

  float mainScale = mix(1.0, 0.7, progress);
  int iLayers = int(layers);

  for(int i = iLayers; i >= 1; --i){
    float f = float(i) / floor(layers);
    float scale_i = mix(mainScale, 1.0, f);
    vec2 p = (uv - center) / scale_i + center;

    float m = step(0.0, p.x) * step(p.x, 1.0) * step(0.0, p.y) * step(p.y, 1.0);

    color = mix(color, sampleInput(p), m);
  }

  vec2 p = (uv - center) / mainScale + center;
  float m = step(0.0,p.x) * step(p.x, 1.0) * step(0.0,p.y) * step(p.y, 1.0);
  color = mix(color, sampleInput(p), m);

  gl_FragColor = toOutputFormat(color);
}
";
