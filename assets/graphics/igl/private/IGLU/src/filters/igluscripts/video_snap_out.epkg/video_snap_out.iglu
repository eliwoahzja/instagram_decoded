[Filter VideoSnapOut]
[MaskBehavior alpha]

# Composable wrapper — delegates to VideoSnap with outro=1.0

[Init]
fun init(Filter filter) {
  filter.passes = {
    {
      name = 'snapOut,
      igid = 'video_snap_in,
      inputs = {'default},
      uniforms = {
        outro = 1.0,
      },
    }
  };

  filter.parameters = {
    {progress = 0.0, min = 0.0, max = 1.0, description = "Animation Progress"},
    {center = {0.5, 0.5}, min = {0.0, 0.0}, max = {1.0, 1.0}},
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  setShaderUniform('snapOut, 'progress, p);
  setShaderUniform('snapOut, 'outro, 1.0);
  setShaderUniform('snapOut, 'center, getParameterVec2('center));
}
