[Filter Iphone14]
# "iPhone 14" — pure single-LUT color filter. Cloned from glamy.iglu
# byte-for-byte (Clone-then-Deviate); only identifier / displayName /
# legacyId / Filter-name / LUT input name changed.
#
# Spark patch reference:
#   cameraTexture0 -> FastColorLUT_f -> material
#
# LUT wired via Named Input (no manifest asset entry yet per the spec).
# For sample-app testing, drop the LUT PNG in the Named Inputs panel
# with input name "lut". For production, the host can push the LUT
# texture via setNamedInput("lut", tex) or wire the Custom Parameter
# string `lut_path` that the [PreRender] block resolves to a
# textureFilePath:// URI.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        {strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        strength = 1.0,
      },
      glslShader = glslLut,
    }};
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, s);
}

#### GLSL shader ####

string glslLut = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);

      texel.rgb = clamp(texel.rgb, 0.00781, 0.98438);

      float x = texel.r / 8.0;
      float y = texel.g / 8.0;
      float z = texel.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      texel = mix(texel, vec4(color, texel.a), strength);

      gl_FragColor = toOutputFormat(texel);
    }
    ";
