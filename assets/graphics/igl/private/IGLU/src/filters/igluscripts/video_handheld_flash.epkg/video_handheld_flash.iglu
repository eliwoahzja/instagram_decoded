# IGLUSCRIPTCOLLISION_BYPASS: Intentional replacement of C++ native effect - IGLUScript takes precedence on Android/iOS; C++ filter retained as fallback for direct C++ callers (sample app, server tools).

[Filter VideoHandheldFlash]
# Handheld Flash: exposure pulse plus handheld camera shake with motion blur.
#
# `useBeats` selects the driver in [PreRender], not in the shaders:
#   false -> exposure from a free-running sine
#   true  -> exposure and shake amplitude scale with `beatProgress`
# BeatReactiveController writes `useBeats` when a manifest declares beatReactive; otherwise
# the false default selects the clock.

[Init]
fun init(Filter filter) {
    loadTexture('noiseTex, 'texture://TextEffectsSharedAssets/PerlinNoise);

    filter.parameters = {
        {intensity = 0.5, min = 0.0, max = 1.0, description = "Flash and shake strength"},
        {speed = 0.5, min = 0.0, max = 1.0, description = "Pulse and shake speed"},
        {beatProgress = 0.0, min = 0.0, max = 1.0, description = "Beat-driven amplitude"},
        {useBeats = false, description = "True while the beat system is driving this effect"},
    };

    filter.passes = {
        {
            name = 'exposure_pulse,
            inputs = {'default},
            uniforms = {
                calculatedExposure = 1.0,
            },
            glslShader = glslExposurePulse,
        },
        {
            name = 'handheld_shake,
            inputs = {'exposure_pulse, 'noiseTex},
            uniforms = {
                time_sec = 0.0,
                outputSize = {1080.0, 1920.0},
                progress = 1.0,
                shake_speed = 0.35,
                shake_scale = 5.0,
                rotation_scale = 50.0,
                motion_blur_strength = 1.0,
                crop = 0.0,
                center = {0.5, 0.5},
            },
            glslShader = glslHandheldShake,
        },
    };
}

[PreRender]
fun preRender(Filter filter) {
    boolean useBeats = getParameterBoolean('useBeats);

    f32 intensity = getParameterFloat('intensity);
    f32 speed = getParameterFloat('speed);

    # Slider ranges match VideoHandheldFlashFilter.cpp.
    f32 exposureBase = 4.0 * intensity;
    f32 shakeScale = 10.0 * intensity;
    f32 rotationScale = 100.0 * intensity;
    f32 motionBlurStrength = 2.0 * intensity;
    f32 pulseSpeed = 4.0 * speed;
    f32 shakeSpeed = 0.7 * speed;

    f32 calculatedExposure = 1.0;

    if (useBeats) {
        # Exposure rests at 1.0, so the beat scales its deviation from neutral. Shake,
        # rotation and motion blur rest at 0 and scale directly. `shake_speed` is pinned so
        # the wobble rate stays fixed and the beat controls only how far it travels.
        f32 beat = getParameterFloat('beatProgress);

        calculatedExposure = 1.0 + beat * (exposureBase - 1.0);
        calculatedExposure = max(calculatedExposure, 1.0);

        shakeScale = shakeScale * beat;
        rotationScale = rotationScale * beat;
        motionBlurStrength = motionBlurStrength * beat;
        shakeSpeed = 0.35;
    } else {
        # Free-running exposure pulse, evaluated per frame.
        f32 time = getParameterFloat('time_sec);
        f32 exposurePulse = sin(time * pulseSpeed * 6.2831);
        f32 exposurePulseCurve = (exposurePulse + 1.0) * 0.5;
        exposurePulseCurve = pow(exposurePulseCurve, -0.2);
        exposurePulseCurve = clamp(exposurePulseCurve, 0.0, 1.0 + (exposureBase / 10.0));
        exposurePulse = exposurePulseCurve;
        exposurePulse = 1.0 + (exposurePulse - 1.0) * exposureBase;
        calculatedExposure = max(exposurePulse, 1.0);
    }

    setShaderUniform('exposure_pulse, 'calculatedExposure, calculatedExposure);

    setShaderUniform('handheld_shake, 'shake_speed, shakeSpeed);
    setShaderUniform('handheld_shake, 'shake_scale, shakeScale);
    setShaderUniform('handheld_shake, 'rotation_scale, rotationScale);
    setShaderUniform('handheld_shake, 'motion_blur_strength, motionBlurStrength);

    # Written every frame: [Init] defaults do not reach the shader for vec2 uniforms, or for
    # any uniform BaseUniformsOpenGL declares.
    vec2 shakeCenter = {0.5, 0.5};
    setShaderUniform('handheld_shake, 'center, shakeCenter);
    setShaderUniform('handheld_shake, 'crop, 0.0);
    setShaderUniform('handheld_shake, 'time_sec, getParameterFloat('time_sec));
    setShaderUniform('handheld_shake, 'progress, 1.0);
    setShaderUniform('handheld_shake, 'outputSize, getTextureSize('default));
}

#### Pass 0: exposure ####

string glslExposurePulse = "
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;

    uniform float calculatedExposure;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec4 base = sampleInput(uv);
        gl_FragColor = toOutputFormat(vec4(base.rgb * calculatedExposure, base.a));
    }
";

#### Pass 1: handheld shake with motion blur ####
# `auxSampler1` is 'noiseTex — aux inputs bind by their index in `inputs`, not by name.

string glslHandheldShake = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;

    uniform float time_sec;
    uniform vec2 outputSize;
    uniform float progress;
    uniform float shake_speed;
    uniform float shake_scale;
    uniform float rotation_scale;
    uniform float motion_blur_strength;
    uniform sampler2D auxSampler1;
    uniform float crop;
    uniform vec2 center;

    vec3 shakeOffset(float t) {
        float tx = fract(t);
        float noiseX = texture2D(auxSampler1, vec2(tx, 0.0)).r;
        float noiseY = texture2D(auxSampler1, vec2(fract(t + 0.3), 0.0)).r;
        float noiseZ = texture2D(auxSampler1, vec2(fract(t + 0.6), 0.0)).r;
        return vec3(noiseX, noiseY, noiseZ);
    }

    vec2 rotateUV(vec2 uv, float angle) {
        float s = sin(angle);
        float c = cos(angle);
        uv = vec2(uv.x * c - uv.y * s, uv.x * s + uv.y * c);
        return uv;
    }

    void main() {
        vec2 uv = sourceTextureCoordinate;
        float t = time_sec * (shake_speed * 0.5);

        float img_crop = 0.99 - ((shake_scale * progress) * 0.005);
        img_crop /= (crop + 1.0);
        uv = (uv - 0.5) * img_crop + 0.5;

        float shutter_speed = motion_blur_strength * 0.005;
        vec3 shakePrev = shakeOffset(t - shutter_speed * 0.5);
        vec3 shakeCurrent = shakeOffset(t);
        vec3 shakeNext = shakeOffset(t + shutter_speed * 0.5);

        vec2 shakeMultiplier = vec2(shake_scale * 0.005);
        float rotationMultiplier = rotation_scale * 0.002;

        vec2 prevFrame = (shakePrev.xy * 2.0 - 1.0) * shakeMultiplier;
        vec2 currentFrame = (shakeCurrent.xy * 2.0 - 1.0) * shakeMultiplier;

        float prevAngle = (shakePrev.z * 2.0 - 1.0) * rotationMultiplier;
        float currentAngle = (shakeCurrent.z * 2.0 - 1.0) * rotationMultiplier;

        vec2 ratio = outputSize.xy / outputSize.y;
        vec2 ctr = (center - 0.5) * ratio;
        vec2 st = (uv - 0.5) * ratio;

        vec2 st0 = rotateUV(st - ctr + prevFrame, prevAngle) + ctr;
        st0 = st0 / ratio + 0.5;
        vec2 st1 = rotateUV(st - ctr + currentFrame, currentAngle) + ctr;
        st1 = st1 / ratio + 0.5;

        vec4 color = (sampleInput(st0) + sampleInput(st1)) / 2.0;
        gl_FragColor = toOutputFormat(color);
    }
";
