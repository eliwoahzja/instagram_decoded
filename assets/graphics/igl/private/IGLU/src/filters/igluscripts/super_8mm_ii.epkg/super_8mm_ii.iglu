[Filter Super8mmII]
# "Super 8mm" (ii) — vintage Super-8 film look ported from the Spark AR
# effect (effectId 1148529555804931). Distinct from the already-landed
# `super_8mm` (legacyId 3084) — different source effect, hence the `_ii`
# stem per the black_ii / film_burn_ii naming convention.
#
# Cloned from old_film.iglu (which already has LUT grade + procedural
# scratches + a soft-edged rounded-rect black frame). Single fragment pass,
# bottom -> top:
#
#   Layer 1 — Base LUT color grade (through a subtle projector-weave shift)
#   Layer 2 — Contrast/darkening (approximates the source camera self-multiply)
#   Layer 3 — Rouge boost (warm rosy lift; replaces the source's face makeup)
#   Layer 4 — Animated dust specks (procedural, bounded 16-frame loop)
#   Layer 5 — Animated film scratches (procedural, 12-frame loop, subtract)
#   Layer 6 — Film grain (procedural, screen blend)
#   Layer 7 — Soft rounded-rect black frame / gate matte (SDF, screen-locked)
#
# The source's 18-frame @24fps sequence was a black matte with a soft
# rounded-rect window + baked-in scratches; recreated here procedurally as
# Layer 7 (the matte) + Layers 4/5 (the scratches). Face-tracked skin
# smoothing + makeup are intentionally dropped (rouge boost stands in).
#
# Time source: getLocalTime() (monotonic). GLSL only — Metal is generated by
# the runtime shaderc compiler.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        # Layer 1 LUT + weave.
        {lut_strength = 1.0, min = 0.0, max = 1.0, description = "LUT mix strength (1.0 = full LUT, 0.0 = camera passthrough)"},
        {shift_magnitude = 0.002, min = 0.0, max = 0.08, description = "Projector-weave content drift magnitude in UV (0 = locked)"},
        {jitter_rate = 6.5, min = 1.0, max = 60.0, description = "Average weave events per second"},

        # Layer 2 contrast darkening.
        {contrast_strength = 0.4, min = 0.0, max = 1.0, description = "Film contrast/darkening (self-multiply) amount"},

        # Layer 3 rouge boost.
        {rouge_strength = 0.3, min = 0.0, max = 1.0, description = "Warm rosy rouge boost (replaces face makeup)"},

        # Layer 4 dust.
        {dust_opacity = 0.2, min = 0.0, max = 1.0, description = "Animated dust speck multiply-darken opacity"},
        {dust_density = 0.4, min = 0.0, max = 1.0, description = "Dust speck density (0 = sparse, 1 = dense)"},
        {dust_fps = 8.0, min = 1.0, max = 30.0, description = "Dust animation frame rate"},

        # Layer 5 scratches.
        {scratch_strength = 0.12, min = 0.0, max = 1.0, description = "Animated vertical scratch subtract opacity"},

        # Layer 6 grain.
        {grain_opacity = 0.14, min = 0.0, max = 1.0, description = "Procedural grain screen-blend opacity"},

        # Layer 7 frame / gate matte. Separate X/Y borders so the window
        # aspect (how tall vs wide) is dial-able independently.
        {frame_border_x = 0.07, min = 0.0, max = 0.45, description = "Black gate border on left/right (fraction of canvas per side)"},
        {frame_border_y = 0.18, min = 0.0, max = 0.45, description = "Black gate border on top/bottom (raise to make the window less tall)"},
        {frame_corner_radius = 0.128, min = 0.0, max = 0.3, description = "Rounded-corner radius of the gate window (UV units)"},
        {frame_softness = 0.016, min = 0.0, max = 0.15, description = "Softness/fuzziness of the gate window edge"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        lut_strength = 1.0,
        shift_magnitude = 0.002,
        jitter_rate = 6.5,
        contrast_strength = 0.4,
        rouge_strength = 0.3,
        dust_opacity = 0.2,
        dust_density = 0.4,
        dust_fps = 8.0,
        scratch_strength = 0.12,
        grain_opacity = 0.14,
        frame_border_x = 0.07,
        frame_border_y = 0.18,
        frame_corner_radius = 0.128,
        frame_softness = 0.016,
        aspect = 1.0,
        time = 0.0,
      },
      glslShader = glslSuper8mmII,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 sm = getParameterFloat('shift_magnitude);
    setShaderUniform('pass0, 'shift_magnitude, sm);

    f32 jr = getParameterFloat('jitter_rate);
    setShaderUniform('pass0, 'jitter_rate, jr);

    f32 cs = getParameterFloat('contrast_strength);
    setShaderUniform('pass0, 'contrast_strength, cs);

    f32 rg = getParameterFloat('rouge_strength);
    setShaderUniform('pass0, 'rouge_strength, rg);

    f32 dop = getParameterFloat('dust_opacity);
    setShaderUniform('pass0, 'dust_opacity, dop);

    f32 dde = getParameterFloat('dust_density);
    setShaderUniform('pass0, 'dust_density, dde);

    f32 dfp = getParameterFloat('dust_fps);
    setShaderUniform('pass0, 'dust_fps, dfp);

    f32 ss = getParameterFloat('scratch_strength);
    setShaderUniform('pass0, 'scratch_strength, ss);

    f32 gop = getParameterFloat('grain_opacity);
    setShaderUniform('pass0, 'grain_opacity, gop);

    f32 fbx = getParameterFloat('frame_border_x);
    setShaderUniform('pass0, 'frame_border_x, fbx);

    f32 fby = getParameterFloat('frame_border_y);
    setShaderUniform('pass0, 'frame_border_y, fby);

    f32 fcr = getParameterFloat('frame_corner_radius);
    setShaderUniform('pass0, 'frame_corner_radius, fcr);

    f32 fs = getParameterFloat('frame_softness);
    setShaderUniform('pass0, 'frame_softness, fs);

    # Aspect-correct the gate SDF so the rounded corners stay circular on a
    # portrait canvas (isotropic radius). Falls back to 1.0 if size unknown.
    vec2 in_size = getTextureSize('default);
    f32 aspect = 1.0;
    if (in_size.y > 0.0) {
        aspect = in_size.x / in_size.y;
    }
    setShaderUniform('pass0, 'aspect, aspect);

    # Use getLocalTime() for monotonic continuous animation.
    f32 time = getLocalTime();
    setShaderUniform('pass0, 'time, time);
}

#### GLSL shader ####

string glslSuper8mmII = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lut

    uniform float lut_strength;
    uniform float shift_magnitude;
    uniform float jitter_rate;
    uniform float contrast_strength;
    uniform float rouge_strength;
    uniform float dust_opacity;
    uniform float dust_density;
    uniform float dust_fps;
    uniform float scratch_strength;
    uniform float grain_opacity;
    uniform float frame_border_x;
    uniform float frame_border_y;
    uniform float frame_corner_radius;
    uniform float frame_softness;
    uniform float aspect;
    uniform float time;

    float hash11(float x) {
      return fract(sin(x * 12.9898) * 43758.5453);
    }
    float hash21(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }
    vec2 hash22(vec2 p) {
      return fract(sin(vec2(dot(p, vec2(127.1, 311.7)),
                            dot(p, vec2(269.5, 183.3)))) * 43758.5453);
    }

    // 8x8 grid LUT lookup on auxSampler1.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    // Signed distance to a rounded-rect. `p` is a centered coordinate
    // (already aspect-corrected by the caller); `b` = half-extents, `r` = radius.
    float sdRoundedRect(vec2 p, vec2 b, float r) {
      vec2 q = abs(p) - b + vec2(r);
      return length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
    }

    // Cell-grid dark dust specks. Returns coverage in [0, 1].
    float dustSpecks(vec2 uv, float frame_seed, float density) {
      float grid_scale = 30.0 + density * 40.0;
      vec2 off = vec2(frame_seed * 13.7, frame_seed * 7.3);
      vec2 g = floor(uv * grid_scale + off);
      vec2 cell = fract(uv * grid_scale + off);
      vec2 rp = hash22(g);
      float has = step(1.0 - density * 0.5, hash21(g + frame_seed));
      float d = distance(cell, rp);
      float sz = 0.06 + hash21(g + vec2(1.7)) * 0.12;
      return clamp(has * smoothstep(sz, 0.0, d), 0.0, 1.0);
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;

      // ============================================================
      // Layer 1: subtle projector weave + LUT grade (empty-LUT fallback).
      // ============================================================
      float perturb = sin(time * jitter_rate * 0.37 + 1.7) * 0.45;
      float jit = floor(time * jitter_rate + perturb);
      vec2 drift = vec2(hash11(jit * 13.31 + 1.7) * 2.0 - 1.0,
                        hash11(jit * 17.71 + 3.1) * 2.0 - 1.0);
      vec2 content_uv = uv - drift * shift_magnitude;

      vec4 cam = sampleInput(content_uv);
      vec3 lut_rgb = lutLookup(cam.rgb);
      vec3 lut_probe = texture2D(auxSampler1, vec2(0.5, 0.5)).rgb;
      float lut_loaded = step(0.05,
          max(max(lut_probe.r, lut_probe.g), lut_probe.b));
      vec3 result = mix(cam.rgb, lut_rgb, lut_strength * lut_loaded);

      // ============================================================
      // Layer 2: contrast darkening (approx camera self-multiply).
      // ============================================================
      result = mix(result, result * result, contrast_strength);

      // ============================================================
      // Layer 3: rouge boost (warm rosy lift).
      // ============================================================
      vec3 rouged = result * vec3(1.0 + 0.12 * rouge_strength,
                                  1.0 + 0.02 * rouge_strength,
                                  1.0 - 0.05 * rouge_strength);
      result = clamp(rouged, 0.0, 1.0);

      // ============================================================
      // Layer 4: animated dust specks (multiply darken), bounded loop.
      // ============================================================
      float dframe = mod(floor(time * dust_fps), 16.0);
      float dust = dustSpecks(uv, dframe, dust_density);
      result = mix(result, result * (1.0 - dust), dust_opacity);

      // ============================================================
      // Layer 5: animated vertical film scratches (subtract), 12-frame loop.
      // ============================================================
      float sframe = floor(mod(time * 12.0, 12.0));
      float sseed = sframe * 7.31 + 0.137;
      float scratch = 0.0;
      for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float exists = step(0.45, hash11(sseed * 11.7 + fi * 3.13));
        float x = hash11(sseed * 13.31 + fi * 19.71);
        float w = 0.0012 + 0.0016 * hash11(sseed * 19.7 + fi * 13.13);
        float dashh = step(0.35, fract(uv.y * 40.0 + hash11(sseed + fi) * 10.0));
        scratch += exists * step(abs(content_uv.x - x), w) * mix(1.0, dashh, 0.4);
      }
      scratch = clamp(scratch, 0.0, 1.0);
      result = clamp(result - vec3(scratch * scratch_strength), 0.0, 1.0);

      // ============================================================
      // Layer 6: procedural grain (screen blend), 3-frame loop @ 7fps.
      // ============================================================
      float gframe = mod(floor(time * 7.0), 3.0);
      float grain = fract(sin(uv.x * 127.1 + uv.y * 311.7 + gframe * 74.3)
                          * 43758.5453);
      vec3 screened = vec3(1.0) - (vec3(1.0) - result)
                      * (vec3(1.0) - vec3(grain));
      result = mix(result, screened, grain_opacity);

      // ============================================================
      // Layer 7: soft rounded-rect black frame / gate matte (screen-locked).
      // Computed in an aspect-corrected, height-normalized space (x scaled by
      // `aspect = width/height`) so the corner radius is ISOTROPIC and the
      // corners render as true circular arcs on a portrait canvas instead of
      // stretched/cropped ellipses. The straight-edge positions are unchanged
      // (the aspect factor cancels for the edges, only the corners are fixed).
      // ============================================================
      vec2 p = (uv - 0.5) * vec2(aspect, 1.0);
      vec2 half_extent = vec2((0.5 - frame_border_x) * aspect, 0.5 - frame_border_y);
      float sdf = sdRoundedRect(p, half_extent, frame_corner_radius);
      float in_frame = 1.0 - smoothstep(-frame_softness, frame_softness, sdf);
      result = mix(vec3(0.0), result, in_frame);

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
