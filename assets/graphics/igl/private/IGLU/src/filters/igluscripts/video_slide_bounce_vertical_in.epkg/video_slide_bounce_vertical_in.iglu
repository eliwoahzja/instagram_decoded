[Filter IgluscriptCutoutSlideBounceVerticalInFilter]
[MaskBehavior alpha]

# AE source: POSITION_SLIDEBOUNCE_DOWN_IN / POSITION_SLIDEBOUNCE_DOWN_OUT
# Position values in raw pixels (offset from center)

fun mix(f32 a, f32 b, f32 t) f32 {
  return a * (1.0 - t) + b * t;
}

fun cssBezier(f32 time, f32 x1, f32 y1, f32 x2, f32 y2) f32 {
  f32 t = time;
  f32 i = 0.0;
  while (i < 8.0) {
    f32 u = 1.0 - t;
    f32 xt = 3.0 * u * u * t * x1 + 3.0 * u * t * t * x2 + t * t * t;
    f32 dxdt = 3.0 * u * u * x1 + 6.0 * u * t * (x2 - x1) + 3.0 * t * t * (1.0 - x2);
    t = t - (xt - time) / max(dxdt, 0.0001);
    t = clamp(t, 0.0, 1.0);
    i = i + 1.0;
  }
  f32 u = 1.0 - t;
  return 3.0 * u * u * t * y1 + 3.0 * u * t * t * y2 + t * t * t;
}

# Evaluate position at any progress value (returns raw pixel offset)
fun evalPosY(f32 p, f32 outro) f32 {
  f32 posY = 0.0;
  f32 f = 0.0;
  f32 t = 0.0;

  if (outro < 0.5) {
    # IN: 7-keyframe damped bounce (2520ms)
    if (p < 0.047619) {
      f = p / 0.047619;
      t = cssBezier(f, 0.05, 0.364506, 0.037592, 0.926798);
      posY = mix(texH, -24.493, t);
    } else if (p < 0.190476) {
      f = (p - 0.047619) / (0.190476 - 0.047619);
      t = cssBezier(f, 0.556891, -0.449554, 0.591835, 0.833669);
      posY = mix(-24.493, 10.697, t);
    } else if (p < 0.349206) {
      f = (p - 0.190476) / (0.349206 - 0.190476);
      t = cssBezier(f, 0.526603, -0.477991, 0.673522, 0.865227);
      posY = mix(10.697, -6.857, t);
    } else if (p < 0.52381) {
      f = (p - 0.349206) / (0.52381 - 0.349206);
      t = cssBezier(f, 0.331975, -0.256263, 0.709215, 0.837284);
      posY = mix(-6.857, 3.469, t);
    } else if (p < 0.730159) {
      f = (p - 0.52381) / (0.730159 - 0.52381);
      t = cssBezier(f, 0.274787, -0.36635, 0.739845, 0.746893);
      posY = mix(3.469, -1.653, t);
    } else if (p < 1.0) {
      f = (p - 0.730159) / (1.0 - 0.730159);
      t = cssBezier(f, 0.214861, -0.847179, 0.293408, 1.0);
      posY = mix(-1.653, 0.0, t);
    } else {
      posY = 0.0;
    }
  } else {
    # OUT: 4-keyframe exit bounce (880ms)
    if (p < 0.454359) {
      f = p / 0.454359;
      posY = mix(0.0, 10.697, f);
    } else if (p < 0.86359) {
      f = (p - 0.454359) / (0.86359 - 0.454359);
      t = cssBezier(f, 0.526603, -0.214595, 0.037592, 0.22309);
      posY = mix(10.697, -24.493, t);
    } else if (p < 1.0) {
      f = (p - 0.86359) / (1.0 - 0.86359);
      posY = mix(-24.493, 100.0, f);
    } else {
      posY = 100.0;
    }
  }

  return posY;
}

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {direction = 0.0, min = 0.0, max = 1.0, description = "Direction code: up = 2, down = 3"},
    {outro = 0.0, min = 0.0, max = 1.0, description = "0 = In, 1 = Out"},
  };

  filter.passes = {
    {
      name = 'dirBlur,
      inputs = {'default},
      uniforms = {
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = blurGlsl,
    },
    {
      name = 'slideFx,
      inputs = {'dirBlur},
      uniforms = {
        position = {0.0, 0.0},
        scaleY = 1.0,
        opacity = 1.0,
        ghostSpread = 0.0,
        ghostDir = {0.0, 0.0},
      },
      glslShader = glsl,
    },
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  f32 outro = getParameterFloat('outro);
  f32 dir = getParameterFloat('direction);
  # Host delivers 'direction as a Direction code: up = 2, down = 3.
  # Split up/down (both > 0.5) rather than the old 0/1 float scheme.
  f32 sign = 1.0;
  if (dir < 2.5) { sign = 0.0 - 1.0; }
  # IN entry is spatially opposite of OUT exit for the same sign; flip for IN only.
  if (outro < 0.5) { sign = 0.0 - sign; }

  # Tuning scalars
  f32 posScale = 5.0;
  f32 blurScale = 4.0;

  vec2 size = getTextureSize('default);
  f32 texH = size.y;

  # Evaluate position at current and previous frame for velocity-based blur
  f32 posY = evalPosY(p, outro);
  f32 posYPrev = evalPosY(max(p - 0.008, 0.0), outro);

  # Convert pixel offset to UV offset
  f32 offsetUV = posY * posScale / texH;
  f32 offset = sign * offsetUV;

  # Velocity-based directional blur: blur proportional to speed, not position
  f32 velocity = abs(posY - posYPrev) * posScale / texH;
  f32 blurAmount = velocity * blurScale;

  # For OUT: scale blur by distance from center to simulate acceleration
  if (outro > 0.5) {
    f32 distRatio = clamp(abs(offsetUV) / (100.0 * posScale / texH), 0.0, 1.0);
    blurAmount = blurAmount * (1.0 + distRatio * 9.0);
  }

  # Position-based blur boost for OUT: ramp blur as content exits far from center
  if (outro > 0.5) {
    f32 posBlur = clamp(abs(offsetUV) / (100.0 * posScale / texH), 0.0, 1.0);
    posBlur = posBlur * posBlur;
    blurAmount = max(blurAmount, posBlur * 0.15);
  }

  # Squash/stretch proportional to position offset magnitude
  f32 absOffset = abs(offsetUV);
  f32 maxOffsetUV = 100.0 * posScale / texH;
  f32 squish = clamp(absOffset / maxOffsetUV, 0.0, 1.0);
  f32 scaleY = mix(1.0, 0.4, squish);

  f32 texelSize = 1.0 / texH;
  f32 ghostSpread = blurAmount * 10.0 * texelSize;
  vec2 ghostDir = {0.0, sign};

  # Opacity ramp: fade in over first 0.1s, fade out over last 0.1s
  f32 rampDuration = 0.002;
  f32 opacity = 1.0;
  if (outro < 0.5) {
    opacity = clamp(p / rampDuration, 0.0, 1.0);
  } else {
    opacity = clamp((1.0 - p) / rampDuration, 0.0, 1.0);
  }

  vec2 pos = {0.0, offset};
  setShaderUniform('dirBlur, 'ghostSpread, ghostSpread);
  setShaderUniform('dirBlur, 'ghostDir, ghostDir);
  setShaderUniform('slideFx, 'position, pos);
  setShaderUniform('slideFx, 'scaleY, scaleY);
  setShaderUniform('slideFx, 'ghostSpread, ghostSpread * 0.5);
  setShaderUniform('slideFx, 'ghostDir, ghostDir);
  setShaderUniform('slideFx, 'opacity, opacity);
}

string blurGlsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform float ghostSpread;
uniform vec2 ghostDir;

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 offset = ghostDir * ghostSpread * fi;
    float k = 2.0;
    float weight = 1.0 / (1.0 + k * abs(fi));
    color += sampleInput(uv + offset) * weight;
    totalWeight += weight;
  }

  gl_FragColor = toOutputFormat(color / totalWeight);
}
";

string glsl = "varying vec2 sourceTextureCoordinate;

BaseUniformsOpenGL;

uniform vec2 position;
uniform float scaleY;
uniform float opacity;
uniform float ghostSpread;
uniform vec2 ghostDir;

float clipAlpha(vec2 uv) {
  float e = 0.005;
  return smoothstep(0.0, e, uv.x) * smoothstep(0.0, e, 1.0 - uv.x)
       * smoothstep(0.0, e, uv.y) * smoothstep(0.0, e, 1.0 - uv.y);
}

void main() {
  vec2 uv = sourceTextureCoordinate;
  // DOWN (-1.0 on OpenGL, +1.0 on Metal) flips position.y for OpenGL's
  // bottom-left origin so the slide direction matches the iOS/Metal path.
  uv.x -= position.x;
  uv.y -= DOWN * position.y;
  uv.y = (uv.y - 0.5) / max(scaleY, 0.001) + 0.5;

  vec4 color = vec4(0.0);
  float totalWeight = 0.0;

  for (int i = -4; i <= 4; i++) {
    float fi = float(i);
    vec2 gUV = uv - ghostDir * ghostSpread * fi;
    float ca = clipAlpha(gUV);

    float k = 2.0;
    float falloff = 1.0 / (1.0 + k * abs(fi));
    falloff = pow(falloff, 0.5);

    float w = falloff * ca;
    color += sampleInput(gUV) * w;
    totalWeight += w;
  }

  color /= max(totalWeight, 0.001);
  color *= opacity;
  gl_FragColor = toOutputFormat(color);
}
";
