[Filter TextSoftMaskIn]
#
# Port of C++ text_soft_mask_in/TextSoftMaskInFilter.cpp (shared common_shaders/SoftMaskShader.cpp,
# outro = 0). Single-pass soft horizontal wipe: a ramped alpha edge sweeps across the glyphs as the
# intro progress runs 0 -> 1. The C++ `bool isRTL` is expressed here as a float (0/1) so it stays a
# plain shaderc uniform. Faithful to the C++ TEXT shader; Metal is auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {progress = 0.0},
        {ramp = 0.1, description = "Width of the soft alpha edge"},
        {outro = 0.0, description = "0 = appearing (In), 1 = disappearing (Out)"},
        {isRTL = 0.0, description = "0 = left-to-right wipe, 1 = right-to-left"},
    };

    filter.passes = {{
        name = 'softMaskIn,
        inputs = {'default},
        uniforms = {
            progress = 0.0,
            ramp = 0.1,
            outro = 0.0,
            isRTL = 0.0,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    setShaderUniform('softMaskIn, 'progress, getParameterFloat('progress));
    setShaderUniform('softMaskIn, 'ramp, getParameterFloat('ramp));
    setShaderUniform('softMaskIn, 'outro, getParameterFloat('outro));
    setShaderUniform('softMaskIn, 'isRTL, getParameterFloat('isRTL));
}


# --- GLSL Shader (faithful port of SoftMaskShader.cpp softMaskFragmentShaderStr) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform float progress;
    uniform float ramp;
    uniform float outro;
    uniform float isRTL;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec4 samp = sampleInput(uv);
        float p = progress * (1.0 + ramp * 2.0);
        p -= ramp;
        float x = mix(uv.x, 1.0 - uv.x, step(0.5, isRTL));
        float a_out = smoothstep(-ramp * 0.5, ramp * 0.5, x - p);
        float a_in = smoothstep(ramp * 0.5, -ramp * 0.5, x - p);
        float a = mix(a_in, a_out, step(0.5, outro));
        samp *= a;
        gl_FragColor = toOutputFormat(samp);
    }
";
