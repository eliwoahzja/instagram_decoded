[Filter NaturalSkin]
# "Natural Skin" — single LUT + saturation + red-channel post-adjust.
# Three logical layers in a single fragment pass.
#
#   Layer 1 — Base LUT (full canvas):
#     8x8 grid LUT lookup on natural_skin_lut.png, mixed against camera
#     by `lut_strength`. Standard glamy-style pattern.
#
#   Layer 2 — Saturation adjust (post-LUT):
#     Luminance-preserving saturation multiplier. `mix(luma, graded,
#     saturation)` with Rec.709 luma weights — same primitive used in
#     neutrals_lovers. Default ~1.10 for a subtle vibrance lift.
#
#   Layer 3 — Red channel adjust (post-LUT):
#     Tiny additive offset on the red channel only, to warm skin tones
#     subtly without reading as a tint. Default ~0.04 (out of [0, 1]).
#
# Composite order (bottom -> top):
#   camera -> LUT -> saturation -> red lift
#
# // TODO: skin smoothing + rouge boost on lips and cheeks
# // Requires face landmark anchoring — not yet available in IGLUScript
# // Ref: https://www.internalfb.com/intern/fx/debug/?effectid=1369268647176986

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        # Layer 1 LUT.
        {lut_strength = 0.6, min = 0.0, max = 1.0, description = "LUT mix strength (1.0 = full LUT, 0.0 = camera passthrough)"},

        # Layer 2 saturation (luminance-preserving).
        {saturation = 1.48, min = 0.0, max = 2.0, description = "Global saturation multiplier (1.0 = no change; <1 = mute; >1 = boost)"},

        # Layer 3 red lift.
        {red_lift = -0.009, min = -0.20, max = 0.20, description = "Additive offset on red channel only (subtle warmth lift)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        lut_strength = 0.6,
        saturation = 1.48,
        red_lift = -0.009,
      },
      glslShader = glslNaturalSkin,
    }};
}

# Custom Parameter strings for sample-app local-loading.
string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 ls = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, ls);

    f32 sat = getParameterFloat('saturation);
    setShaderUniform('pass0, 'saturation, sat);

    f32 rl = getParameterFloat('red_lift);
    setShaderUniform('pass0, 'red_lift, rl);
}

#### GLSL shader ####

string glslNaturalSkin = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lut

    uniform float lut_strength;
    uniform float saturation;
    uniform float red_lift;

    // 8x8 grid LUT lookup on auxSampler1.
    vec3 lutLookup(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    void main() {
      vec4 cam = sampleInput(sourceTextureCoordinate);

      // ============================================================
      // Layer 1: LUT-graded camera, mixed against passthrough by
      // lut_strength (standard mix() pattern, same as glamy).
      // Includes a graceful fallback for WIP / not-yet-uploaded LUTs.
      // ============================================================
      vec3 lut_rgb = lutLookup(cam.rgb);
      vec3 lut_probe = texture2D(auxSampler1, vec2(0.5, 0.5)).rgb;
      float lut_loaded = step(0.05,
          max(max(lut_probe.r, lut_probe.g), lut_probe.b));
      vec3 graded = mix(cam.rgb, lut_rgb, lut_strength * lut_loaded);

      // ============================================================
      // Layer 2: Saturation boost (luminance-preserving). Mix between
      // a grey-of-luminance and the graded RGB by `saturation`.
      // ============================================================
      float lum = dot(graded, vec3(0.2126, 0.7152, 0.0722));
      vec3 saturated = clamp(
          mix(vec3(lum), graded, saturation), 0.0, 1.0);

      // ============================================================
      // Layer 3: Red channel additive lift. Subtle warmth nudge.
      // ============================================================
      vec3 result = saturated;
      result.r = clamp(result.r + red_lift, 0.0, 1.0);

      gl_FragColor = toOutputFormat(vec4(result, cam.a));
    }
    ";
