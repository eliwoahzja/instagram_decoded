{
  "schemaVersion": 1,
  "iglu": {
    "customization": [
      {
        "name": "beatProgress",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "beatReactive": {
          "mode": "envelope",
          "envelope": {
            "attack": 0.0,
            "decay": 0.9,
            "sustain": 0.0,
            "release": 0.0,
            "curve": "linear",
            "timing": "beatRelative"
          },
          "range": [
            0.0,
            1.0
          ]
        }
      },
      {
        "name": "beatAmplitude",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "beatReactive": {
          "mode": "pulse",
          "pulse": {
            "width": 30.0,
            "softness": 0.0
          },
          "range": [
            0.0,
            1.0
          ]
        }
      }
    ]
  }
}
