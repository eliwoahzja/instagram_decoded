{
  "schemaVersion": 1,
  "iglu": {
    "customization": [
      {
        "name": "beatProgress",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "beatReactive": {
          "mode": "step",
          "stepValues": [
            0.0,
            1.0
          ]
        }
      }
    ]
  }
}
