[Filter CPM35]
# "CPM 35" -- Spark AR port. Effect ID 1667876533673899 (111M DAP,
# Color Enhancement category).
#
# 3-stage color-and-softening filter:
#   Stage 1 -- 9-tap softening blur (Spark default blur = 0.35 mix).
#   Stage 2 -- 8x8 grid LUT color grade (strength-controlled mix).
#   Stage 3 -- Procedural film grain overlay (default 0.6 opacity,
#              size 0.4 chunk scale).
#
# LUT delivered via ARD; local sample-app testing loads from
# assets/cpm_35/cpm_35_lut.png via the lut_path string parameter.
#
# Time source: getLocalTime() for grain frame-to-frame animation
# per the Time Source rule for continuous animations.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        {strength       = 1.0,   min = 0.0, max = 1.0,  description = "LUT mix strength (1.0 = full LUT, 0.0 = camera passthrough)"},
        {blur_strength  = 0.35,  min = 0.0, max = 1.0,  description = "Softening 9-tap blur mix amount (Spark default 0.35)"},
        {blur_radius    = 0.005, min = 0.0, max = 0.05, description = "Softening kernel radius in normalized UV"},
        {grain_strength = 0.6,   min = 0.0, max = 1.0,  description = "Procedural grain opacity (Spark default 0.6)"},
        {grain_size     = 0.4,   min = 0.0, max = 1.0,  description = "Grain pattern scale (0 = fine grain / high freq, 1 = large chunky grain)"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        strength       = 1.0,
        blur_strength  = 0.35,
        blur_radius    = 0.005,
        grain_strength = 0.6,
        grain_size     = 0.4,
        time           = 0.0,
      },
      glslShader = glslCpm35,
    }};
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('strength);
    setShaderUniform('pass0, 'strength, s);

    f32 blr = getParameterFloat('blur_strength);
    setShaderUniform('pass0, 'blur_strength, blr);

    f32 blrad = getParameterFloat('blur_radius);
    setShaderUniform('pass0, 'blur_radius, blrad);

    f32 gs = getParameterFloat('grain_strength);
    setShaderUniform('pass0, 'grain_strength, gs);

    f32 gsz = getParameterFloat('grain_size);
    setShaderUniform('pass0, 'grain_size, gsz);

    f32 t = getLocalTime();
    setShaderUniform('pass0, 'time, t);
}

#### GLSL shader ####

string glslCpm35 = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;  // 'default (camera)
    uniform sampler2D auxSampler1;  // 'lut

    uniform float blur_strength;
    uniform float blur_radius;
    uniform float grain_strength;
    uniform float grain_size;
    uniform float time;

    // 2D hash for grain (matches old_movie / video_film_style grain pattern).
    float hash21(vec2 p) {
      return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
    }

    // 8x8 grid LUT lookup, catalog convention.
    vec3 applyLut(vec3 inRgb) {
      vec3 c = clamp(inRgb, 0.00781, 0.98438);
      float x = c.r / 8.0;
      float y = c.g / 8.0;
      float z = c.b;
      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;
      x += blueX;
      y += blueY;
      return texture2D(auxSampler1, vec2(x, y)).xyz;
    }

    void main() {
      vec2 uv = sourceTextureCoordinate;

      // Stage 1: 9-tap weighted softening blur.
      float r = blur_radius;
      vec3 center = sampleInput(uv).rgb;
      vec3 blurred = center * (4.0 / 16.0);
      blurred += sampleInput(uv + vec2( r, 0.0)).rgb * (2.0 / 16.0);
      blurred += sampleInput(uv + vec2(-r, 0.0)).rgb * (2.0 / 16.0);
      blurred += sampleInput(uv + vec2(0.0,  r)).rgb * (2.0 / 16.0);
      blurred += sampleInput(uv + vec2(0.0, -r)).rgb * (2.0 / 16.0);
      blurred += sampleInput(uv + vec2( r,  r)).rgb * (1.0 / 16.0);
      blurred += sampleInput(uv + vec2( r, -r)).rgb * (1.0 / 16.0);
      blurred += sampleInput(uv + vec2(-r,  r)).rgb * (1.0 / 16.0);
      blurred += sampleInput(uv + vec2(-r, -r)).rgb * (1.0 / 16.0);
      vec3 softened = mix(center, blurred, blur_strength);

      // Stage 2: LUT grade at strength.
      vec3 graded = applyLut(softened);
      vec3 result = mix(softened, graded, strength);

      // Stage 3: Procedural grain overlay.
      // grain_size maps to noise-coord scale: 0 = fine (1024x freq),
      // 1 = chunky (~102x freq). Time-varying at 24 fps.
      float grain_scale = mix(1024.0, 102.0, grain_size);
      float t_frame = floor(time * 24.0);
      float grain = hash21(uv * grain_scale + vec2(t_frame, t_frame * 1.7)) - 0.5;
      result += vec3(grain * grain_strength * 0.15);
      result = clamp(result, 0.0, 1.0);

      gl_FragColor = toOutputFormat(vec4(result, 1.0));
    }
    ";
