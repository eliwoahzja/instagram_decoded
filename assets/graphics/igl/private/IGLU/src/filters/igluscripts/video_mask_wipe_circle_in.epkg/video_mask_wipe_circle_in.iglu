[Filter MaskWipeCircleIn]
[MaskBehavior alpha]

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {amount = 0.2, min = 0.0, max = 1.0, description = "Edge smoothness"},
    };

    filter.passes = {{
        name = 'base,
        igid = 'video_mask_wipe_circle,
        inputs = {'default},
        uniforms = {
            outro = 0.0,
        }
    }};
}

[PreRender]
fun preRender(Filter filter) {
    f32 amount = getParameterFloat('amount);
    # remap normalized amount to shader edge range [0,0.2], kept off 0 for smoothstep
    amount = max(0.001, amount * 0.2);
    setShaderUniform('base, 'amount, amount);
}
