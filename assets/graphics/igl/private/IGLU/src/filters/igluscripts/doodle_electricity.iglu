[Filter DoodleElectricity]
[MaskBehavior alpha]

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {displaceAmountA = 0.033, min = 0.0, max = 0.1, description = "Displace Amount A"},
    {displaceAmountB = 0.035, min = 0.0, max = 0.1, description = "Displace Amount B"},
    {noiseScaleA = 8.43, min = 1.0, max = 20.0, description = "Noise Scale A"},
    {noiseSpeedA = 5.05, min = 0.0, max = 15.0, description = "Noise Speed A"},
    {noiseScaleB = 7.20, min = 1.0, max = 20.0, description = "Noise Scale B"},
    {noiseSpeedB = 4.89, min = 0.0, max = 15.0, description = "Noise Speed B"},
  };

  filter.passes = {
  {
    name = 'noiseA,
    inputs = {'default},
    uniforms = {
      uTime = 0.0,
      uNoiseScale = 8.43,
      uNoiseSpeed = 5.05,
      uOctaves = 3.0,
      uSeed = 37.0,
      uResolution = {1080.0, 1920.0},
      contentScale = {1.0, 1.0},
    },
    glslShader = noiseGlsl,
  },
  {
    name = 'noiseB,
    inputs = {'default},
    uniforms = {
      uTime = 0.0,
      uNoiseScale = 7.20,
      uNoiseSpeed = 4.89,
      uOctaves = 4.0,
      uSeed = 42.0,
      uResolution = {1080.0, 1920.0},
      contentScale = {1.0, 1.0},
    },
    glslShader = noiseGlsl,
  },
  {
    name = 'compose,
    inputs = {'default, 'noiseA, 'noiseB},
    uniforms = {
      uDisplaceAmountA = 0.033,
      uDisplaceAmountB = 0.035,
      contentAR = 0.5625,
      contentScale = {1.0, 1.0},
    },
    glslShader = composeGlsl,
  }
  };
}

[PreRender]
fun preRender(Filter filter) {
  vec2 size = getTextureSize('default);
  f32 contentAR = getParameterFloat('contentAspectRatio);
  if (contentAR < 0.001) { contentAR = size.x / size.y; }
  vec2 contentScale = getParameterVec2('contentScale);
  if (contentScale.x < 0.001) { contentScale = {1.0, 1.0}; }
  vec2 contentRes = {contentAR, 1.0};

  f32 displaceAmountA = getParameterFloat('displaceAmountA);
  f32 displaceAmountB = getParameterFloat('displaceAmountB);
  f32 noiseScaleA = getParameterFloat('noiseScaleA);
  f32 noiseSpeedA = getParameterFloat('noiseSpeedA);
  f32 noiseScaleB = getParameterFloat('noiseScaleB);
  f32 noiseSpeedB = getParameterFloat('noiseSpeedB);
  f32 time = getParameterFloat('time_sec);

  # Noise pass A
  setShaderUniform('noiseA, 'uTime, time);
  setShaderUniform('noiseA, 'uNoiseScale, noiseScaleA);
  setShaderUniform('noiseA, 'uNoiseSpeed, noiseSpeedA);
  setShaderUniform('noiseA, 'uResolution, contentRes);
  setShaderUniform('noiseA, 'contentScale, contentScale);

  # Noise pass B
  setShaderUniform('noiseB, 'uTime, time);
  setShaderUniform('noiseB, 'uNoiseScale, noiseScaleB);
  setShaderUniform('noiseB, 'uNoiseSpeed, noiseSpeedB);
  setShaderUniform('noiseB, 'uResolution, contentRes);
  setShaderUniform('noiseB, 'contentScale, contentScale);

  # Compose pass
  setShaderUniform('compose, 'uDisplaceAmountA, displaceAmountA);
  setShaderUniform('compose, 'uDisplaceAmountB, displaceAmountB);
  setShaderUniform('compose, 'contentAR, contentAR);
  setShaderUniform('compose, 'contentScale, contentScale);
}

# ==========================================================================
# Pass 1-2: Animated 3D Simplex FBM noise field
# ==========================================================================
string noiseGlsl = "
precision highp float;
varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform float uTime;
uniform float uNoiseScale;
uniform float uNoiseSpeed;
uniform float uOctaves;
uniform float uSeed;
uniform vec2 uResolution;
uniform vec2 contentScale;

float taylorInvSqrt1(float r) {
  return 1.79284291400159 - 0.85373472095314 * r;
}
vec4 taylorInvSqrt4(vec4 r) {
  return 1.79284291400159 - 0.85373472095314 * r;
}
float mod289f(float x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 mod289v3(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 mod289v4(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute3(vec3 x) { return mod289v3(((x * 34.0) + 1.0) * x); }
vec4 permute4(vec4 x) { return mod289v4(((x * 34.0) + 1.0) * x); }

float snoise(vec3 v) {
  vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
  vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
  vec3 i = floor(v + dot(v, vec3(C.y, C.y, C.y)));
  vec3 x0 = v - i + dot(i, vec3(C.x, C.x, C.x));
  vec3 g = step(vec3(x0.y, x0.z, x0.x), vec3(x0.x, x0.y, x0.z));
  vec3 l = 1.0 - g;
  vec3 i1 = min(vec3(g.x, g.y, g.z), vec3(l.z, l.x, l.y));
  vec3 i2 = max(vec3(g.x, g.y, g.z), vec3(l.z, l.x, l.y));
  vec3 x1 = x0 - i1 + vec3(C.x, C.x, C.x);
  vec3 x2 = x0 - i2 + vec3(C.y, C.y, C.y);
  vec3 x3 = x0 - vec3(D.y, D.y, D.y);
  i = mod289v3(i);
  vec4 p = permute4(permute4(permute4(
      i.z + vec4(0.0, i1.z, i2.z, 1.0))
      + i.y + vec4(0.0, i1.y, i2.y, 1.0))
      + i.x + vec4(0.0, i1.x, i2.x, 1.0));
  float n_ = 0.142857142857;
  vec3 ns = n_ * vec3(D.w, D.y, D.z) - vec3(D.x, D.z, D.x);
  vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
  vec4 x_ = floor(j * ns.z);
  vec4 y_ = floor(j - 7.0 * x_);
  vec4 x = x_ * ns.x + vec4(ns.y, ns.y, ns.y, ns.y);
  vec4 y = y_ * ns.x + vec4(ns.y, ns.y, ns.y, ns.y);
  vec4 h = 1.0 - abs(x) - abs(y);
  vec4 b0 = vec4(x.x, x.y, y.x, y.y);
  vec4 b1 = vec4(x.z, x.w, y.z, y.w);
  vec4 s0 = floor(b0) * 2.0 + 1.0;
  vec4 s1 = floor(b1) * 2.0 + 1.0;
  vec4 sh = -step(h, vec4(0.0));
  vec4 a0 = vec4(b0.x, b0.z, b0.y, b0.w) + vec4(s0.x, s0.z, s0.y, s0.w) * vec4(sh.x, sh.x, sh.y, sh.y);
  vec4 a1 = vec4(b1.x, b1.z, b1.y, b1.w) + vec4(s1.x, s1.z, s1.y, s1.w) * vec4(sh.z, sh.z, sh.w, sh.w);
  vec3 p0 = vec3(a0.x, a0.y, h.x);
  vec3 p1 = vec3(a0.z, a0.w, h.y);
  vec3 p2 = vec3(a1.x, a1.y, h.z);
  vec3 p3 = vec3(a1.z, a1.w, h.w);
  vec4 norm = taylorInvSqrt4(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
  p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;
  vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
  m = m * m;
  return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float fbm(vec2 st, float t, float octaves) {
    float value = 0.0;
    float amplitud = 0.5;
    for (int i = 0; i < 6; i++) {
      if (float(i) >= octaves) break;
      value += amplitud * snoise(vec3(st.x, st.y, t));
      st *= 2.0;
      amplitud *= 0.5;
    }
    return value;
  }

void main() {
  vec2 uv = sourceTextureCoordinate;
  vec2 res = uResolution / uResolution.y;
  float t = uTime * uNoiseSpeed + uSeed;
  vec2 st = uv * vec2(contentScale.x, contentScale.y) * res * uNoiseScale * 2.0;
  float nX = fbm(st, t, uOctaves) * 0.5 + 0.5;
  float nY = fbm(st + vec2(73.7, 91.1), t, uOctaves) * 0.5 + 0.5;
  gl_FragColor = toOutputFormat(vec4(nX, nY, 0.0, 1.0));
}
";

# ==========================================================================
# Pass 3: Displace stroke UVs with both noise fields, apply outline color
# ==========================================================================
string composeGlsl = "
precision highp float;
varying vec2 sourceTextureCoordinate;
BaseUniformsOpenGL;

uniform sampler2D auxSampler1;
uniform sampler2D auxSampler2;
uniform float uDisplaceAmountA;
uniform float uDisplaceAmountB;
uniform float contentAR;
uniform vec2 contentScale;

void main() {
  vec2 uv = sourceTextureCoordinate;
  float aspect = contentAR;

  vec4 noiseA = texture2D(auxSampler1, uv);
  vec4 noiseB = texture2D(auxSampler2, uv);

  vec2 displaceA = vec2(noiseA.r - 0.5, noiseA.g - 0.5) * uDisplaceAmountA;
  vec2 displaceB = vec2(noiseB.r - 0.5, noiseB.g - 0.5) * uDisplaceAmountB;

  displaceA /= contentScale;
  displaceA.x /= aspect;
  displaceB /= contentScale;
  displaceB.x /= aspect;

  vec4 sampleA = sampleInput(uv + displaceA);
  vec4 sampleB = sampleInput(uv + displaceB);
  float combinedAlpha = max(sampleA.a, sampleB.a);

  // Get brush color from whichever displaced sample has more coverage
  vec4 dominant = sampleA.a > sampleB.a ? sampleA : sampleB;
  vec3 brushColor = dominant.a > 0.001 ? dominant.rgb / dominant.a : vec3(1.0);

  gl_FragColor = toOutputFormat(vec4(brushColor * combinedAlpha, combinedAlpha));
}
";
