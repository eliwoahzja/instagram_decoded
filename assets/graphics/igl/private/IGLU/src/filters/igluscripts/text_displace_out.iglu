[Filter TextDisplaceOut]
#
# Port of C++ text_displace_out/TextDisplaceOutFilter.cpp — identical shader to TextDisplaceIn
# (shared displaceFragmentShaderStr) with outro = 1.0, so the noise-driven distortion sweep runs
# in reverse (settled -> scattered) as the outro progress runs 0 -> 1, scattering the glyphs out.
# Faithful to the C++ TEXT shader, with the same shaderc-safe adaptations as text_displace_in:
# the overloaded map() is split into map()/mapSimple(), the out-of-bounds guard is a scalar clip,
# and the two divisions are clamped away from zero. Metal is auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {progress = 0.0},
        {outro = 1.0, description = "0 = appearing (In), 1 = disappearing (Out)"},
        {scale_xChannel = 0.25, description = "Scale animation curve row"},
        {scale_xMin = 0.0, description = "Scale min value"},
        {scale_xMax = 1.034, description = "Scale max value"},
        {distortionChannel = 0.75, description = "Distortion animation curve row"},
        {distortionMin = 0.0, description = "Distortion min value"},
        {distortionMax = 0.25, description = "Distortion max value"},
        {phase = 0.0, description = "Animation phase offset"},
    };

    loadTexture('animation, 'texture://TextEffectsSharedAssets/DisplaceIn);

    filter.passes = {{
        name = 'displaceOut,
        inputs = {'default, 'animation},
        uniforms = {
            outputSize = {100.0, 100.0},
            progress = 0.0,
            scale_xChannel = 0.25,
            scale_xMin = 0.0,
            scale_xMax = 1.034,
            distortionChannel = 0.75,
            distortionMin = 0.0,
            distortionMax = 0.25,
            phase = 0.0,
            outro = 1.0,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    vec2 defaultSize = getTextureSize('default);
    setShaderUniform('displaceOut, 'outputSize, defaultSize);

    setShaderUniform('displaceOut, 'progress, getParameterFloat('progress));
    setShaderUniform('displaceOut, 'outro, getParameterFloat('outro));
    setShaderUniform('displaceOut, 'scale_xChannel, getParameterFloat('scale_xChannel));
    setShaderUniform('displaceOut, 'scale_xMin, getParameterFloat('scale_xMin));
    setShaderUniform('displaceOut, 'scale_xMax, getParameterFloat('scale_xMax));
    setShaderUniform('displaceOut, 'distortionChannel, getParameterFloat('distortionChannel));
    setShaderUniform('displaceOut, 'distortionMin, getParameterFloat('distortionMin));
    setShaderUniform('displaceOut, 'distortionMax, getParameterFloat('distortionMax));
    setShaderUniform('displaceOut, 'phase, getParameterFloat('phase));
}


# --- GLSL Shader (faithful port of TextDisplaceOutFilter.cpp displaceFragmentShaderStr) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform vec2 outputSize;
    uniform float progress;
    uniform float scale_xChannel;
    uniform float scale_xMin;
    uniform float scale_xMax;
    uniform float distortionChannel;
    uniform float distortionMin;
    uniform float distortionMax;
    uniform float phase;
    uniform float outro;

    uniform sampler2D auxSampler1;

    vec4 sampleAnimation(sampler2D tex, float t, float channel) {
        vec2 uv1 = vec2(t, channel);
        vec4 samp1 = texture2D(tex, uv1);
        return samp1;
    }

    float map(float x, float lowIn, float highIn, float lowOut, float highOut) {
        if (highIn == lowIn)
            return highIn;
        float w = highIn - lowIn;
        x = x - lowIn;
        x /= w;
        float ow = highOut - lowOut;
        x *= ow;
        x += lowOut;
        return x;
    }

    float mapSimple(float x, float lowOut, float highOut) {
        return map(x, 0.0, 1.0, lowOut, highOut);
    }

    float byteCombine(vec2 v) {
        float highByte = v.r * 255.0;
        float lowByte = v.g * 255.0;
        float scaled = highByte * 256.0 + lowByte;
        float normalized = scaled / 65535.0;
        return normalized;
    }

    float dot_noise(vec3 p) {
        const float PHI = 1.618033988;
        const mat3 GOLD = mat3(
            -0.571464913, +0.814921382, +0.096597072,
            -0.278044873, -0.303026659, +0.911518454,
            +0.772087367, +0.494042493, +0.399753815);
        return dot(cos(GOLD * p), sin(PHI * p * GOLD));
    }

    vec4 blendAlphaPremult(vec4 base, vec4 blend) {
        return blend + base * (1.0 - blend.a);
    }

    vec4 sampleInputClipped(vec2 uv) {
        vec4 color = sampleInput(uv);
        float inBounds = step(0.0, uv.x) * step(uv.x, 1.0) * step(0.0, uv.y) * step(uv.y, 1.0);
        return color * inBounds;
    }

    void main() {
        vec4 color = vec4(0.0);
        float t = mix(progress, 1.0 - progress, step(0.5, outro));
        t += phase;

        vec4 scale_sample = sampleAnimation(auxSampler1, t, scale_xChannel);
        vec4 distortion_sample = sampleAnimation(auxSampler1, t, distortionChannel);

        float scale = byteCombine(scale_sample.rg);
        scale = mapSimple(scale, scale_xMin, scale_xMax);
        float distortion = byteCombine(distortion_sample.rg);
        distortion = mapSimple(distortion, distortionMin, distortionMax);

        vec2 aspect = vec2(1.0, outputSize.x / outputSize.y);
        vec2 uv = sourceTextureCoordinate;

        uv -= 0.5;
        uv /= aspect;
        uv /= max(scale, 0.001);
        vec3 np = vec3(uv * 50.0, progress * 15.0);
        float distortion_mod = dot_noise(np);
        distortion_mod -= length(uv) * 20.0;
        distortion_mod /= 3.0;
        distortion_mod *= distortion;
        uv /= max(1.0 + distortion_mod, 0.001);
        uv *= aspect;
        uv += 0.5;

        vec4 samp = sampleInputClipped(uv);
        color = blendAlphaPremult(color, samp * samp.a);

        gl_FragColor = toOutputFormat(color);
    }
";
