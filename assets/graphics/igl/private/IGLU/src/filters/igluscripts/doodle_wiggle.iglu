[Filter DoodleWiggle]
[MaskBehavior alpha]

# Single-pass UV displacement with stop-motion snapping

[Init]
fun init(Filter filter) {
  filter.parameters = {
    {stopMotionFPS = 7.0, min = 1.0, max = 30.0, description = "Stop motion FPS"},
    {sineEnabled = 1.0, min = 0.0, max = 1.0, description = "Sine enabled"},
    {yAmplitude = 0.0017, min = 0.0, max = 0.02, description = "Y amplitude"},
    {yFrequency = 12.0, min = 1.0, max = 50.0, description = "Y frequency"},
    {ySpeed = 25.0, min = 0.0, max = 50.0, description = "Y speed"},
    {xAmplitude = 0.0012, min = 0.0, max = 0.02, description = "X amplitude"},
    {xFrequency = 15.5, min = 1.0, max = 50.0, description = "X frequency"},
    {xSpeed = 24.0, min = 0.0, max = 50.0, description = "X speed"},
    {phaseOffset = 4.3, min = 0.0, max = 6.28, description = "Phase offset"},
    {noiseEnabled = 1.0, min = 0.0, max = 1.0, description = "Noise enabled"},
    {noiseYAmplitude = 0.003, min = 0.0, max = 0.05, description = "Noise Y amplitude"},
    {noiseYScale = 10.0, min = 1.0, max = 30.0, description = "Noise Y scale"},
    {noiseYSpeed = 4.4, min = 0.0, max = 10.0, description = "Noise Y speed"},
    {noiseXAmplitude = 0.002, min = 0.0, max = 0.05, description = "Noise X amplitude"},
    {noiseXScale = 6.0, min = 1.0, max = 30.0, description = "Noise X scale"},
    {noiseXSpeed = 2.3, min = 0.0, max = 10.0, description = "Noise X speed"},
    # Per-layer decorrelation. Offsets the sine phases and the noise sampling coordinates so two
    # doodles that start at the same time do not wiggle in unison. Deliberately NOT added to `time`:
    # that would shift the stop-motion quantization boundary (layers would stop snapping on the same
    # frames) and inflate `time` toward the 23-bit f32 limit. 0.0 = original single-layer behaviour.
    {phaseSeed = 0.0, min = 0.0, max = 289.0, description = "Per-layer phase seed"},
  };

  filter.passes = {
    {
      name = 'pass0,
      inputs = {'default},
      uniforms = {
        time = 0.0, contentAR = 0.5625, contentScale = {1.0, 1.0}, outputSize = {1080.0, 1920.0},
        sineEnabled = 1.0, yAmplitude = 0.0017, yFrequency = 12.0, ySpeed = 25.0,
        xAmplitude = 0.0012, xFrequency = 15.5, xSpeed = 24.0, phaseOffset = 4.3,
        noiseEnabled = 1.0, noiseYAmplitude = 0.003, noiseYScale = 10.0, noiseYSpeed = 4.4,
        noiseXAmplitude = 0.002, noiseXScale = 6.0, noiseXSpeed = 2.3, phaseSeed = 0.0
      },
      glslShader = glslWiggle
    }
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 rawTime = getParameterFloat('time_sec);
  f32 fps = getParameterFloat('stopMotionFPS);
  vec2 outSize = getTextureSize('default);
  f32 contentAR = getParameterFloat('contentAspectRatio);
  if (contentAR < 0.001) { contentAR = outSize.x / outSize.y; }
  vec2 contentScale = getParameterVec2('contentScale);
  if (contentScale.x < 0.001) { contentScale = {1.0, 1.0}; }

  # Stop-motion quantization
  f32 interval = 1.0 / max(fps, 1.0);
  f32 time = floor(rawTime / interval) * interval;

  setShaderUniform('pass0, 'time, time);
  setShaderUniform('pass0, 'outputSize, outSize);
  setShaderUniform('pass0, 'contentAR, contentAR);
  setShaderUniform('pass0, 'contentScale, contentScale);

  setShaderUniform('pass0, 'sineEnabled, getParameterFloat('sineEnabled));
  setShaderUniform('pass0, 'yAmplitude, getParameterFloat('yAmplitude));
  setShaderUniform('pass0, 'yFrequency, getParameterFloat('yFrequency));
  setShaderUniform('pass0, 'ySpeed, getParameterFloat('ySpeed));
  setShaderUniform('pass0, 'xAmplitude, getParameterFloat('xAmplitude));
  setShaderUniform('pass0, 'xFrequency, getParameterFloat('xFrequency));
  setShaderUniform('pass0, 'xSpeed, getParameterFloat('xSpeed));
  setShaderUniform('pass0, 'phaseOffset, getParameterFloat('phaseOffset));

  setShaderUniform('pass0, 'noiseEnabled, getParameterFloat('noiseEnabled));
  setShaderUniform('pass0, 'noiseYAmplitude, getParameterFloat('noiseYAmplitude));
  setShaderUniform('pass0, 'noiseYScale, getParameterFloat('noiseYScale));
  setShaderUniform('pass0, 'noiseYSpeed, getParameterFloat('noiseYSpeed));
  setShaderUniform('pass0, 'noiseXAmplitude, getParameterFloat('noiseXAmplitude));
  setShaderUniform('pass0, 'noiseXScale, getParameterFloat('noiseXScale));
  setShaderUniform('pass0, 'noiseXSpeed, getParameterFloat('noiseXSpeed));

  setShaderUniform('pass0, 'phaseSeed, getParameterFloat('phaseSeed));
}

# ═══════════════════════════════════════════════════════════════
# GLSL Shaders
# ═══════════════════════════════════════════════════════════════

string glslWiggle = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;

  uniform float time;
  uniform float sineEnabled;
  uniform float noiseEnabled;
  uniform float yAmplitude;
  uniform float yFrequency;
  uniform float ySpeed;
  uniform float xAmplitude;
  uniform float xFrequency;
  uniform float xSpeed;
  uniform float phaseOffset;
  uniform float noiseYAmplitude;
  uniform float noiseYScale;
  uniform float noiseYSpeed;
  uniform float noiseXAmplitude;
  uniform float noiseXScale;
  uniform float noiseXSpeed;
  uniform vec2 outputSize;
  uniform float contentAR;
  uniform vec2 contentScale;
  uniform float phaseSeed;

  vec4 permute(vec4 x) {
    return mod(((x*34.0)+1.0)*x, 289.0);
  }

  vec2 fade2(vec2 t) {
    return t*t*t*(t*(t*6.0-15.0)+10.0);
  }

  float cnoise(vec2 P) {
    vec4 Pi = floor(P.xyxy) + vec4(0.0, 0.0, 1.0, 1.0);
    vec4 Pf = fract(P.xyxy) - vec4(0.0, 0.0, 1.0, 1.0);
    Pi = mod(Pi, 289.0);
    vec4 ix = Pi.xzxz;
    vec4 iy = Pi.yyww;
    vec4 fx = Pf.xzxz;
    vec4 fy = Pf.yyww;
    vec4 i = permute(permute(ix) + iy);
    vec4 gx = 2.0 * fract(i * 0.0243902439) - 1.0;
    vec4 gy = abs(gx) - 0.5;
    vec4 tx = floor(gx + 0.5);
    gx = gx - tx;
    vec2 g00 = vec2(gx.x, gy.x);
    vec2 g10 = vec2(gx.y, gy.y);
    vec2 g01 = vec2(gx.z, gy.z);
    vec2 g11 = vec2(gx.w, gy.w);
    vec4 norm = 1.79284291400159 - 0.85373472095314 *
        vec4(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11));
    g00 *= norm.x;
    g01 *= norm.y;
    g10 *= norm.z;
    g11 *= norm.w;
    float n00 = dot(g00, vec2(fx.x, fy.x));
    float n10 = dot(g10, vec2(fx.y, fy.y));
    float n01 = dot(g01, vec2(fx.z, fy.z));
    float n11 = dot(g11, vec2(fx.w, fy.w));
    vec2 fade_xy = fade2(Pf.xy);
    vec2 n_x = mix(vec2(n00, n01), vec2(n10, n11), fade_xy.x);
    float n_xy = mix(n_x.x, n_x.y, fade_xy.y);
    return 2.3 * n_xy;
  }

  void main() {
    vec2 uv = sourceTextureCoordinate;

    float aspect = contentAR;
    vec2 pixelUV = vec2(uv.x * aspect * contentScale.x, uv.y * contentScale.y);

    float yDisp = sin(pixelUV.x * yFrequency + time * ySpeed + phaseSeed) * yAmplitude / contentScale.y;
    float xDisp = sin(pixelUV.y * xFrequency + time * xSpeed + phaseOffset + phaseSeed) * xAmplitude / contentScale.x;
    vec2 sineOffset = sineEnabled > 0.5 ? vec2(xDisp / aspect, yDisp) : vec2(0.0);

    float noiseYDisp = cnoise(vec2(pixelUV.x * noiseYScale + phaseSeed, time * noiseYSpeed)) * noiseYAmplitude / contentScale.y;
    float noiseXDisp = cnoise(vec2(pixelUV.y * noiseXScale + phaseSeed, time * noiseXSpeed + 43.21)) * noiseXAmplitude / contentScale.x;
    vec2 noiseOffset = noiseEnabled > 0.5 ? vec2(noiseXDisp / aspect, noiseYDisp) : vec2(0.0);

    vec2 distortedCoord = uv + sineOffset + noiseOffset;
    vec4 color = sampleInput(distortedCoord);
    gl_FragColor = toOutputFormat(color);
  }
";
