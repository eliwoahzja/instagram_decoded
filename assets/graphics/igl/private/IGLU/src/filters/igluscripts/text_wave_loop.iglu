[Filter TextWaveLoop]
#
# Port of C++ text_wave_loop/TextWaveLoopFilter.cpp — continuous cosine wave that scrolls the glyphs
# vertically. LOOP family, so the shader's `time` is driven from the host `renderFrameTimeSeconds`
# param (the continuous value the C++ filter reads on Android), NOT `time_sec`. With ignorePadding
# = 1.0 (default) the `padding` uniform is bypassed exactly as in C++. No behavior header (Static).
# Faithful to the C++ TEXT shader; Metal auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {renderFrameTimeSeconds = 0.0, description = "Continuous media time (seconds), host-driven"},
        {speed = 5.0},
        {amplitude = 1.0},
        {frequency = 1.0},
        {frequencyAspect = 1.0},
        {ignorePadding = 1.0},
    };

    filter.passes = {{
        name = 'waveLoop,
        inputs = {'default},
        uniforms = {
            padding = {0.0, 0.0},
            ignorePadding = 1.0,
            amplitude = 1.0,
            frequency = 1.0,
            frequencyAspect = 1.0,
            outputSize = {100.0, 100.0},
            time = 0.0,
            speed = 5.0,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    vec2 defaultSize = getTextureSize('default);
    setShaderUniform('waveLoop, 'outputSize, defaultSize);
    setShaderUniform('waveLoop, 'time, getParameterFloat('renderFrameTimeSeconds));
    setShaderUniform('waveLoop, 'speed, getParameterFloat('speed));
    setShaderUniform('waveLoop, 'amplitude, getParameterFloat('amplitude));
    setShaderUniform('waveLoop, 'frequency, getParameterFloat('frequency));
    setShaderUniform('waveLoop, 'frequencyAspect, getParameterFloat('frequencyAspect));
    setShaderUniform('waveLoop, 'ignorePadding, getParameterFloat('ignorePadding));
}


# --- GLSL Shader (faithful port of TextWaveLoopFilter.cpp waveLoopFragmentShaderStr) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform vec2 padding;
    uniform float ignorePadding;
    uniform float amplitude;
    uniform float frequency;
    uniform float frequencyAspect;
    uniform vec2 outputSize;
    uniform float time;
    uniform float speed;

    void main() {
        vec2 uv = sourceTextureCoordinate;
        vec2 paddingPercentage = padding / outputSize;
        float freq = frequency * outputSize.x / outputSize.y;
        freq = mix(frequency, freq, step(0.5, frequencyAspect));
        float theta =
            smoothstep(paddingPercentage.x * 0.5, 1.0 - paddingPercentage.x * 0.5, uv.x) * freq;
        theta = mix(theta, uv.x * freq, ignorePadding);
        float loopedTime = mod(time * speed, 2.0);
        theta += loopedTime;
        theta *= 3.1415926539;
        float waveAmplitude = mix(paddingPercentage.y, 0.1, ignorePadding);
        uv.y += cos(theta + 3.1415926539) * amplitude * 0.25 * waveAmplitude;
        vec4 color = sampleInput(uv);
        gl_FragColor = toOutputFormat(color);
    }
";
