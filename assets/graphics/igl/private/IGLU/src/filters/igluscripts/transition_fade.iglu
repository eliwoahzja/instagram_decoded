# IGLUSCRIPTCOLLISION_BYPASS: IGLUScript port of transition_fade, QE-selectable for A/B vs TransitionFadeFilter.
[Filter TransitionFade]

[Init]
fun init(Filter filter) {
  makeTexture('transition);
  filter.passes = {{
    name = 'fade,
    inputs = {'default, 'transition},
    shaderInputNames = {'default, 's_texture1},
    uniforms = {
      progress = 0.0,
      fadeColor = {0.0, 0.0, 0.0, 1.0},
      flickerFrequency = 2.0,
      flickerStrength = 0.0,
      flickerSmoothness = 0.8,
    },
    glslShader = glsl,
  }};
}

[PreRender]
fun preRender(Filter filter) {
  setShaderUniform('fade, 'progress, max(getParameterFloat('progress), getParameterFloat('transition_progress)));
}

string glsl = "
  varying vec2 sourceTextureCoordinate;
  BaseUniformsOpenGL;
  uniform sampler2D s_texture1;
  uniform float progress;
  uniform vec4 fadeColor;
  uniform float flickerFrequency;
  uniform float flickerStrength;
  uniform float flickerSmoothness;
  const float pi = 3.1415926536;
  vec4 flickerMap(vec2 uv, float freq, float smoothness, float strength) {
    float flickerBase = freq * 4.0 + 2.0;
    float flickerOffset = 0.5 / flickerBase + uv.x;
    float flickerSimple = (sin(flickerBase * flickerOffset * pi) + 1.0) * 0.5;
    float halfSmoothness = smoothness * 0.5;
    float flickerSmooth = smoothstep(0.5 - halfSmoothness, 0.5 + halfSmoothness, flickerSimple);
    float flicker = mix(abs(uv.x - 0.5) * 2.0, flickerSmooth, strength);
    return vec4(flicker, flicker, flicker, 1.0);
  }
  void main() {
    vec2 uv = sourceTextureCoordinate;
    vec4 color = mix(sampleInput(uv), texture2D(s_texture1, uv), step(0.5, progress));
    float flicker = flickerMap(vec2(progress, 0.0), flickerFrequency, flickerSmoothness, flickerStrength).x;
    gl_FragColor = toOutputFormat(mix(fadeColor, color, flicker));
  }
";
