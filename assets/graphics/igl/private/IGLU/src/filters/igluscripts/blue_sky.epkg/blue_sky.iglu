[Filter BlueSky]
# "Blue Sky" — pure LUT color grading filter. Cloned from colorful.iglu
# per the Clone-then-Deviate pattern in
# `.llms/skills/igluscript-patterns.md`. Name + asset + mix default only.
#
# Single-asset filter on the legacy generic-symbol pattern (`'lut` ↔
# `blue_sky_lut.png`); same convention as colorful / ayushhh / bliss /
# glamy / soft_white / etc.
#
# The Spark source applies its LUT at 64% opacity, so the mix default is
# 0.64 rather than the usual 1.0.
#
# Note: the mix parameter is deliberately named `lut_strength`, NOT
# `strength`. `strength` is framework-owned — `BaseUniformsOpenGL`
# auto-declares it AND the host (and the Mac sample app, via
# `FiltersSession::applyFilterParameters`) writes it into the parameter
# map every frame, defaulting to 1.0. A non-1.0 default baked into a
# `strength` parameter is therefore silently clobbered. Same rename
# rationale as super_8mm.iglu.
#
# The host's `strength` is retained as an outer multiplier so the app can
# still attenuate the whole effect; at the default `strength = 1.0` the
# LUT lands at the intended 0.64.
#
# LUT delivered via ARD; local sample-app testing loads from
# assets/blue_sky/blue_sky_lut.png.

[Init]
fun init(Filter filter)
{
    makeTexture('lut);

    filter.parameters = {
        {lut_strength = 0.64, min = 0.0, max = 1.0, description = "LUT mix strength"},
    };

    filter.passes = {{
      name = 'pass0,
      inputs = {'default, 'lut},
      uniforms = {
        lut_strength = 0.64,
      },
      glslShader = glslLut,
    }};
}

string lut_path = "lut_path";
string lut_filename = "";

[PreRender]
fun preRender(Filter filter){
    string lut_filename_parameter = getParameterString(lut_path);
    if (lut_filename_parameter != "") {
        string new_lut_filename = stringAppend("textureFilePath://", lut_filename_parameter);
        if (new_lut_filename != lut_filename) {
            lut_filename = new_lut_filename;
            loadTexture('lut, lut_filename);
        }
    }

    f32 s = getParameterFloat('lut_strength);
    setShaderUniform('pass0, 'lut_strength, s);
}

#### GLSL shader ####

string glslLut = "
    varying vec2 sourceTextureCoordinate;
    BaseUniformsOpenGL;

    uniform sampler2D auxSampler0;
    uniform sampler2D auxSampler1;
    uniform sampler2D auxSampler2;

    uniform float lut_strength;

    void main() {
      vec4 texel = sampleInput(sourceTextureCoordinate);

      texel.rgb = clamp(texel.rgb, 0.00781, 0.98438);

      float x = texel.r / 8.0;
      float y = texel.g / 8.0;
      float z = texel.b;

      float blueY = floor(z * 8.0) / 8.0;
      float blueX = floor((z - blueY) * 64.0) / 8.0;

      x += blueX;
      y += blueY;

      vec3 color = texture2D(auxSampler1, vec2(x, y)).xyz;

      texel = mix(texel, vec4(color, texel.a), strength * lut_strength);

      gl_FragColor = toOutputFormat(texel);
    }
    ";
