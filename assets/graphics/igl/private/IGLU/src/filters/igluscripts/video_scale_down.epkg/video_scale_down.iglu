[Filter VideoScaleDown]
[MaskBehavior alpha]

# Composable wrapper — delegates to VideoScaleUp with outro=1.0

[Init]
fun init(Filter filter) {
  filter.passes = {
    {
      name = 'scaleDown,
      igid = 'video_scale_up,
      inputs = {'default},
      uniforms = {
        outro = 1.0,
      },
    }
  };

  filter.parameters = {
    {progress = 0.0, min = 0.0, max = 1.0, description = "Animation Progress"},
    {center = {0.5, 0.5}, min = {0.0, 0.0}, max = {1.0, 1.0}},
    {size = 0.85, min = 0.0, max = 1.0, description = "Starting Scale"},
  };
}

[PreRender]
fun preRender(Filter filter) {
  f32 p = getParameterFloat('progress);
  setShaderUniform('scaleDown, 'progress, p);
  setShaderUniform('scaleDown, 'outro, 1.0);
  setShaderUniform('scaleDown, 'center, getParameterVec2('center));
  setShaderUniform('scaleDown, 'size, getParameterFloat('size));
}
