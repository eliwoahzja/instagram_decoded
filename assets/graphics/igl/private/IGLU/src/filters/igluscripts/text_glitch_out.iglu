[Filter TextGlitchOut]
#
# Port of C++ text_glitch_out/TextGlitchOutFilter.cpp (shared common_shaders/GlitchShader.cpp, outro = 1).
# Identical shader to TextGlitchIn with outro = 1.0, so the posterized directional glitch runs in
# reverse as the outro progress runs 0 -> 1, scattering the glyphs out. The fixed 5-iteration loop is
# unrolled by shaderc. Faithful to the C++ TEXT shader; Metal is auto-generated by shaderc.

[Init]
fun init(Filter filter) {
    filter.parameters = {
        {progress = 0.0},
        {outro = 1.0, description = "0 = appearing (In), 1 = disappearing (Out)"},
        {maxOffset = 0.65, description = "Max UV displacement"},
        {timeSteps = 25.0, description = "Number of posterized animation steps"},
        {falloffCurve = 5.0, description = "Exponent on the offset falloff curve"},
    };

    filter.passes = {{
        name = 'glitchOut,
        inputs = {'default},
        uniforms = {
            progress = 0.0,
            outro = 1.0,
            maxOffset = 0.65,
            timeSteps = 25.0,
            falloffCurve = 5.0,
        },
        glslShader = glsl,
    }};
}

[PreRender]
fun preRender(Filter filter) {
    setShaderUniform('glitchOut, 'progress, getParameterFloat('progress));
    setShaderUniform('glitchOut, 'outro, getParameterFloat('outro));
    setShaderUniform('glitchOut, 'maxOffset, getParameterFloat('maxOffset));
    setShaderUniform('glitchOut, 'timeSteps, getParameterFloat('timeSteps));
    setShaderUniform('glitchOut, 'falloffCurve, getParameterFloat('falloffCurve));
}


# --- GLSL Shader (faithful port of GlitchShader.cpp glitchFragmentShaderStr) ---

string glsl = "
    precision highp float;
    varying vec2 sourceTextureCoordinate;

    BaseUniformsOpenGL;
    uniform float progress;
    uniform float outro;
    uniform float maxOffset;
    uniform float timeSteps;
    uniform float falloffCurve;

    float dot_noise(vec3 p) {
        const float PHI = 1.618033988;
        const mat3 GOLD = mat3(
            -0.571464913, +0.814921382, +0.096597072,
            -0.278044873, -0.303026659, +0.911518454,
            +0.772087367, +0.494042493, +0.399753815);
        return dot(cos(GOLD * p), sin(PHI * p * GOLD));
    }

    void main() {
        vec2 uv = sourceTextureCoordinate;
        float p = mix(progress, 1.0 - progress, step(0.5, outro));
        float posterized = ceil(p * timeSteps) / timeSteps;
        for (float x = 0.0; x < 5.0; x += 1.0) {
            float vert = mod(x, 2.0);
            vert = step(0.5, vert);
            vec3 np = vec3(x * 113.45, posterized * 56.2, 0.0);
            float dividing_line = dot_noise(np);
            dividing_line += 3.0;
            dividing_line /= 6.0;
            float flip = step(0.0, dot_noise(np + vec3(5.0, 16.3, -9.0)));
            vec2 offset_h = vec2(step(dividing_line, uv.y) - 0.5, 0.0);
            vec2 offset_v = vec2(0.0, step(dividing_line, uv.x) - 0.5);
            vec2 offset = mix(offset_h, offset_v, vert);
            offset = mix(offset, offset * -1.0, flip);
            float curve = 1.0 - posterized;
            curve = pow(curve, falloffCurve);
            offset *= max(0.0, maxOffset * curve);
            uv += offset;
        }
        vec4 color = sampleInput(uv);
        color *= step(0.001, p);
        gl_FragColor = toOutputFormat(color);
    }
";
